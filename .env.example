PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
PUBLIC_SITE_URL=http://localhost:4321
CHECK_IN_HASH_SECRET=replace_with_at_least_32_random_characters
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
# Optional. Name of the header your proxy writes with the client IP
# (cf-connecting-ip behind Cloudflare, x-forwarded-for behind one reverse proxy).
# Leave empty when Node receives connections directly.
TRUSTED_IP_HEADER=
# Optional as a pair. When both are set, public forms require Cloudflare Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
