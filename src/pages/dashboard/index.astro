---
import Base from "../../layouts/Base.astro";
import MetricCard from "../../components/MetricCard.astro";
import { assertBusinessAccess, requireDataAccess } from "../../lib/auth";
import { dashboardData } from "../../lib/data";
import { FOLLOW_UP_KIND_LABELS, FOLLOW_UP_KINDS } from "../../lib/follow-up";
import { pendingOwnerSignatureBusiness } from "../../lib/terms-access";

const identity = await requireDataAccess(Astro.request, Astro.cookies);
const ownerPreview = identity.isPlatformAdmin && Astro.url.searchParams.get("preview") === "owner";
if (identity.isPlatformAdmin && !ownerPreview && !Astro.url.searchParams.has("business")) {
  return Astro.redirect("/admin", 302);
}
const pendingSignatureBusiness = await pendingOwnerSignatureBusiness(identity);
if (pendingSignatureBusiness) {
  return Astro.redirect(`/terms/sign?business=${encodeURIComponent(pendingSignatureBusiness)}&next=${encodeURIComponent("/dashboard")}`);
}
const data = await dashboardData(identity, Astro.url.searchParams.get("business"));
const { businesses, business, metrics } = data;
if (business && !Astro.url.searchParams.has("business")) {
  return Astro.redirect(`/dashboard?business=${encodeURIComponent(business.slug)}`, 302);
}
const dashboardHref = business ? `/dashboard?business=${encodeURIComponent(business.slug)}` : "/dashboard";
const canManage = business ? await assertBusinessAccess(identity, business.id, false).then(() => true).catch(() => false) : false;
const dateFormat = new Intl.DateTimeFormat("es-US", { dateStyle: "medium", timeStyle: "short" });
const birthdayFormat = new Intl.DateTimeFormat("es-US", { month: "short", day: "numeric", timeZone: "UTC" });
const followUpGroups = metrics ? FOLLOW_UP_KINDS.map((kind) => ({
  kind,
  label: FOLLOW_UP_KIND_LABELS[kind],
  items: metrics.followUps.filter((item) => item.kind === kind),
})).filter((group) => group.items.length > 0) : [];
---

<Base title="Panel | Smart Tap" privateArea isAdmin={identity.isPlatformAdmin && !ownerPreview} previewReadOnly={ownerPreview} dashboardHref={dashboardHref}>
  {ownerPreview && <section class="card" style="padding:12px 16px;margin-bottom:16px"><strong>Vista del dueño · solo lectura.</strong> Los datos son los del negocio seleccionado. Todas las acciones están desactivadas.</section>}
  {!business || !metrics ? (
    <section class="empty card">
      <p class="eyebrow">Smart Tap</p>
      {businesses.length ? (
        <>
          <h1>Selecciona el negocio que quieres ver</h1>
          {Astro.url.searchParams.has("business") && <p class="muted">El negocio del enlace no está disponible para tu cuenta.</p>}
          <form method="get" action="/dashboard" class="business-picker">
            <label for="select-business">Negocio</label>
            <select id="select-business" name="business" required>
              <option value="" disabled selected>Selecciona un negocio</option>
              {businesses.map((item) => <option value={item.slug}>{item.display_name}</option>)}
            </select>
            <button class="button" type="submit">Ver panel</button>
          </form>
        </>
      ) : (
        <>
          <h1>Aún no tienes un negocio asignado</h1>
          <p class="muted">Pide al administrador de Automate IT que agregue tu cuenta.</p>
        </>
      )}
    </section>
  ) : (
    <>
      <header class="page-head">
        <div>
          <p class="eyebrow">Resumen del negocio</p>
          <h1>{business.display_name}</h1>
          <p class="muted">Datos actualizados al cargar esta página.</p>
        </div>
        {businesses.length > 1 && (
          <form method="get">
            <label for="business" class="sr-only">Cambiar negocio</label>
            <select id="business" name="business" onchange="this.form.submit()">
              {businesses.map((item) => <option value={item.slug} selected={item.id === business.id}>{item.display_name}</option>)}
            </select>
          </form>
        )}
      </header>

      <section class="card customer-preview-card" aria-labelledby="customer-preview-title">
        <div>
          <p class="eyebrow">Tu página NFC</p>
          <h2 id="customer-preview-title">Mírala como la ven tus clientes</h2>
          <p>Esta vista es solo de prueba: puedes recorrerla sin registrar clientes ni visitas.</p>
          <p class="preview-help">¿Quieres cambiar el diseño, los colores, el logo o las ofertas? Comunícate con <strong>Gerardo Navas de Automate IT</strong> y te ayudaremos a actualizar tu página.</p>
        </div>
        <a class="button" href={`/preview/${business.id}`} target="_blank" rel="noopener">Ver página como cliente</a>
      </section>

      <section class="metrics" aria-label="Indicadores principales">
        <MetricCard label="Clientes" value={metrics.totalCustomers} note="Registrados" />
        <MetricCard label="Visitas" value={metrics.totalVisits} note="Acumuladas" />
        <MetricCard label="Clientes frecuentes" value={metrics.repeatCustomers} note="Más de una visita" />
        <MetricCard label="Sin regresar" value={metrics.inactiveCustomers} note={`${business.inactivity_days} días o más`} />
      </section>

      <section class="card follow-up-card" aria-labelledby="follow-up-title">
        <div class="card-head">
          <div><h2 id="follow-up-title">Para contactar hoy</h2><p>Oportunidades activas: {metrics.followUps.length}</p></div>
        </div>
        {followUpGroups.length ? (
          <div class="follow-up-groups">
            {followUpGroups.map((group) => (
              <section class="follow-up-group" aria-labelledby={`follow-up-${group.kind}`}>
                <h3 id={`follow-up-${group.kind}`}>{group.label} <span class="group-count">{group.items.length}</span></h3>
                <div class="follow-up-list">
                  {group.items.map((opportunity) => (
                    <article class="follow-up-row">
                      <div class="follow-up-person">
                        <strong>{opportunity.customer.full_name}</strong>
                        <span class="kind-chip">{group.label}</span>
                        <span>{opportunity.reason}</span>
                        <small>Última visita: {dateFormat.format(new Date(opportunity.lastVisit))}</small>
                      </div>
                      <div class="follow-up-actions">
                        {!opportunity.customer.whatsapp_opt_in && <span class="permission-label">Sin permiso para WhatsApp</span>}
                        {canManage && opportunity.customer.whatsapp_opt_in && (
                          <form action="/api/dashboard/follow-up" method="post">
                            <input type="hidden" name="businessId" value={business.id} />
                            <input type="hidden" name="customerId" value={opportunity.customer.id} />
                            <input type="hidden" name="kind" value={opportunity.kind} />
                            <input type="hidden" name="action" value="contact" />
                            <button class="button whatsapp-button" type="submit">Enviar WhatsApp</button>
                          </form>
                        )}
                        {canManage && (
                          <form action="/api/dashboard/follow-up" method="post">
                            <input type="hidden" name="businessId" value={business.id} />
                            <input type="hidden" name="customerId" value={opportunity.customer.id} />
                            <input type="hidden" name="kind" value={opportunity.kind} />
                            <input type="hidden" name="action" value="dismiss" />
                            <button class="dismiss-button" type="submit">Descartar</button>
                          </form>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        ) : <p class="empty-row">No hay contactos pendientes para hoy.</p>}
      </section>

      <section class="dashboard-grid">
        <article class="card table-card customers-card">
          <div class="card-head"><div><h2>Clientes</h2><p>Últimos 250 por visita reciente</p></div></div>
          {metrics.customers.length ? (
            <div class="table-scroll">
              <table>
                <thead><tr><th>Cliente</th><th>Teléfono</th><th>Visitas</th><th>Última visita</th>{canManage && <th><span class="sr-only">Acciones</span></th>}</tr></thead>
                <tbody>
                  {metrics.customers.map((customer) => (
                    <tr>
                      <td><strong>{customer.full_name}</strong></td>
                      <td>{customer.phone_e164}</td>
                      <td><span class="count">{customer.visitCount}</span></td>
                      <td>{dateFormat.format(new Date(customer.last_seen_at))}</td>
                      {canManage && (
                        <td>
                          <div class="customer-actions">
                            {customer.whatsapp_opt_in && (
                              <a class="opt-out-button" href={`/dashboard/customer/${customer.id}/whatsapp-opt-out?businessId=${encodeURIComponent(business.id)}`}>Registrar baja de WhatsApp</a>
                            )}
                            <form action={`/api/dashboard/customer/${customer.id}/delete`} method="post" onsubmit="return confirm('¿Eliminar este cliente y todas sus visitas? Esta acción no se puede deshacer.')">
                              <input type="hidden" name="businessId" value={business.id} />
                              <button class="delete-button" type="submit">Eliminar</button>
                            </form>
                          </div>
                        </td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : <p class="empty-row">El primer cliente aparecerá después de registrar una visita.</p>}
        </article>

        <aside class="card birthdays">
          <div class="card-head"><div><h2>Próximos cumpleaños</h2><p>Siguientes 30 días</p></div></div>
          {metrics.upcomingBirthdays.length ? (
            <ul>
              {metrics.upcomingBirthdays.map((customer) => (
                <li><span class="avatar">{customer.full_name.slice(0, 1)}</span><div><strong>{customer.full_name}</strong><small>{birthdayFormat.format(new Date(`${customer.birthday}T00:00:00Z`))}</small></div></li>
              ))}
            </ul>
          ) : <p class="empty-row">No hay cumpleaños próximos.</p>}
        </aside>
      </section>
    </>
  )}
  <footer class="legal-footer"><a href="/terms">Términos de servicio</a></footer>
</Base>

<style>
  .page-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
  .page-head h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 8px 0; }
  .page-head select { min-height: 44px; padding: 0 36px 0 12px; border: 1px solid #d0d5dd; border-radius: 10px; background: #fff; }
  .metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 20px; }
  .customer-preview-card { display: flex; align-items: center; justify-content: space-between; gap: 28px; margin-bottom: 20px; padding: 24px; border-color: #b2ccff; background: linear-gradient(135deg, #f5f8ff, #fff); }
  .customer-preview-card h2 { margin: 4px 0 7px; font-size: 1.2rem; }
  .customer-preview-card p { margin: 0; color: #475467; }
  .customer-preview-card .preview-help { margin-top: 10px; max-width: 760px; }
  .customer-preview-card .button { flex: 0 0 auto; }
  .follow-up-card { margin-bottom: 20px; overflow: hidden; }
  .follow-up-groups { display: grid; gap: 0; }
  .follow-up-group { border-top: 1px solid #eaecf0; padding: 18px 22px; }
  .follow-up-group h3 { display: flex; align-items: center; gap: 8px; margin: 0 0 12px; font-size: .93rem; color: #344054; }
  .group-count { display: inline-grid; place-items: center; min-width: 24px; height: 24px; border-radius: 20px; background: #eef4ff; color: #3538cd; font-size: .76rem; }
  .follow-up-list { display: grid; gap: 10px; }
  .follow-up-row { display: flex; justify-content: space-between; align-items: center; gap: 18px; padding: 14px; border: 1px solid #eaecf0; border-radius: 12px; }
  .follow-up-person { display: grid; gap: 3px; }
  .follow-up-person span { color: #475467; font-size: .9rem; }
  .follow-up-person .kind-chip { width: fit-content; padding: 2px 7px; border-radius: 999px; background: #f2f4f7; color: #475467; font-size: .7rem; font-weight: 700; }
  .follow-up-person small { color: #98a2b3; }
  .follow-up-actions, .customer-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-wrap: wrap; }
  .follow-up-actions form, .customer-actions form { margin: 0; }
  .whatsapp-button { min-height: 38px; padding: 0 13px; background: #087f5b; font-size: .82rem; }
  .dismiss-button, .opt-out-button, .delete-button { border: 0; background: transparent; font-size: .8rem; font-weight: 700; cursor: pointer; }
  .dismiss-button { color: #475467; }
  .opt-out-button { color: #9a6700; }
  .delete-button { color: #b42318; }
  .permission-label { color: #667085; font-size: .78rem; }
  .dashboard-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 20px; }
  .table-card { overflow: hidden; }
  .card-head { padding: 21px 22px 15px; display: flex; justify-content: space-between; }
  .card-head h2 { font-size: 1.05rem; margin-bottom: 4px; }
  .card-head p { color: #98a2b3; font-size: .78rem; margin: 0; }
  .count { display: inline-grid; place-items: center; min-width: 28px; height: 28px; padding: 0 7px; border-radius: 20px; background: #eef4ff; color: #3538cd; font-weight: 750; }
  .birthdays ul { list-style: none; padding: 0 20px 15px; margin: 0; }
  .birthdays li { display: flex; gap: 12px; align-items: center; padding: 13px 0; border-top: 1px solid #f2f4f7; }
  .birthdays li:first-child { border-top: 0; }
  .birthdays li div { display: grid; gap: 3px; }
  .birthdays small { color: #98a2b3; }
  .avatar { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; background: #f2f4f7; color: #475467; font-weight: 800; }
  .empty, .empty-row { padding: 36px; }
  .business-picker { display: grid; gap: 12px; max-width: 420px; }
  .business-picker select { min-height: 44px; max-width: 100%; }
  .opt-out-button { display: inline-flex; align-items: center; min-height: 44px; }
  .legal-footer { margin-top: 34px; text-align: center; font-size: .82rem; color: #667085; }
  @media (max-width: 960px) { .metrics { grid-template-columns: repeat(2, 1fr); } .dashboard-grid { grid-template-columns: 1fr; } }
  @media (max-width: 700px) { .follow-up-row, .customer-preview-card { align-items: start; flex-direction: column; } .follow-up-actions { justify-content: flex-start; } }
  @media (max-width: 560px) { .page-head { align-items: start; flex-direction: column; } .metrics { grid-template-columns: 1fr 1fr; } }
</style>
