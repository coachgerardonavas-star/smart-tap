---
import Base from "../layouts/Base.astro";
import { getAuthIdentity } from "../lib/auth";

const identity = await getAuthIdentity(Astro.request, Astro.cookies).catch(() => null);
if (identity?.isPlatformAdmin) return Astro.redirect(identity.aal === "aal2" ? "/admin" : "/admin/mfa");
if (identity) return Astro.redirect("/dashboard");
const error = Astro.url.searchParams.get("error");
const next = Astro.url.searchParams.get("next") || "/dashboard";
---

<Base title="Ingresar | Smart Tap" privateArea={false}>
  <div class="login-shell">
    <section class="login-copy">
      <a href="/" class="logo">Smart Tap</a>
      <p class="eyebrow">Panel del negocio</p>
      <h1>Clientes y visitas, en un solo lugar.</h1>
      <p>Consulta quién regresó, quién lleva tiempo sin visitarte y los próximos cumpleaños.</p>
      <a href="/demo" class="demo-link">Ver la demostración</a>
    </section>
    <section class="login-card card">
      <h2>Ingresa a tu cuenta</h2>
      <p class="muted">Usa el correo que recibió acceso al negocio.</p>
      {error && <div class="alert" role="alert">Correo o contraseña incorrectos.</div>}
      <form action="/api/auth/login" method="post">
        <input type="hidden" name="next" value={next} />
        <div class="field">
          <label for="email">Correo</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="password">Contraseña</label>
          <input id="password" name="password" type="password" autocomplete="current-password" minlength="8" required />
        </div>
        <button class="button" type="submit">Ingresar</button>
        <a class="forgot" href="/forgot-password">Olvidé mi contraseña</a>
      </form>
      <footer class="legal-links"><a href="/terms">Términos de servicio</a></footer>
    </section>
  </div>
</Base>

<style>
  .login-shell { min-height: 100vh; display: grid; grid-template-columns: 1fr minmax(340px, 480px); align-items: center; gap: 8vw; width: min(1080px, 90vw); margin: 0 auto; padding: 50px 0; }
  .logo { display: inline-block; margin-bottom: 70px; font-weight: 850; font-size: 1.25rem; text-decoration: none; }
  .login-copy h1 { max-width: 610px; font-size: clamp(2.6rem, 6vw, 4.6rem); margin: 12px 0 20px; }
  .login-copy > p:not(.eyebrow) { max-width: 560px; color: #667085; font-size: 1.1rem; line-height: 1.65; }
  .demo-link { display: inline-block; margin-top: 18px; color: #155eef; font-weight: 750; }
  .login-card { padding: 34px; }
  .login-card h2 { margin-bottom: 8px; }
  form { display: grid; gap: 18px; margin-top: 26px; }
  .forgot { color: #667085; font-size: .88rem; text-align: center; }
  .legal-links { margin-top: 24px; text-align: center; font-size: .82rem; color: #667085; }
  @media (max-width: 800px) { .login-shell { grid-template-columns: 1fr; gap: 36px; } .logo { margin-bottom: 48px; } }
</style>
