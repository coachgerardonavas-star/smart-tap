---
import Base from "../../layouts/Base.astro";
import BrandColorField from "../../components/BrandColorField.astro";
import { requirePlatformAdmin } from "../../lib/auth";
import { siteUrl as configuredSiteUrl } from "../../lib/env";
import { countryOptions, timezoneOptions } from "../../lib/regions";
import { createSupabaseServiceClient } from "../../lib/supabase";
import { contractOverview } from "../../lib/admin-contract-overview";
import type { Business } from "../../lib/types";

await requirePlatformAdmin(Astro.request, Astro.cookies);
const siteUrl = configuredSiteUrl();
const countries = countryOptions();
const service = createSupabaseServiceClient();
const { data, error } = await service.from("businesses").select("*").order("display_name");
if (error) throw error;
const businesses = (data ?? []) as Business[];
const now = new Date();
const cards = businesses.map((business) => ({
  ...business,
  contract: contractOverview(business.term_ends_at, business.cancelled_at, now),
  contractDate: business.term_ends_at && Number.isFinite(Date.parse(business.term_ends_at))
    ? new Intl.DateTimeFormat("es-US", { dateStyle: "medium", timeZone: business.timezone }).format(new Date(business.term_ends_at))
    : null,
  accent: /^#[0-9a-fA-F]{6}$/.test(business.primary_color) ? business.primary_color : "#0052CC",
}));
const dueSoon = cards.filter((business) => business.contract.state === "due-soon").length;
const message = Astro.url.searchParams.get("message");
const formError = Astro.url.searchParams.get("error");
---

<Base title="Inicio | Smart Tap" privateArea isAdmin>
  <header class="page-head">
    <div>
      <p class="eyebrow">Smart Tap · CEO</p>
      <h1>Negocios</h1>
      <p class="muted">Selecciona un negocio para abrir su Vista 360° y administrarlo.</p>
    </div>
    <div class="search-area">
      <label for="business-search">Buscar negocio</label>
      <div class="search-box">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m16 16 5 5"/></svg>
        <input id="business-search" type="search" autocomplete="off" placeholder="Buscar por nombre..." aria-controls="business-card-grid" />
      </div>
    </div>
  </header>
  {message && <div class="alert success">{message}</div>}
  {formError && <div class="alert">{formError}</div>}
  <section class="business-section" id="negocios" aria-labelledby="business-list-title">
    <div class="section-head">
      <div>
        <h2 id="business-list-title">Todos los negocios</h2>
        <p class="muted"><span id="filtered-count">{cards.length}</span> de {cards.length} negocios</p>
      </div>
      {dueSoon > 0 && <p class="expiry-note">{dueSoon} {dueSoon === 1 ? "contrato vence" : "contratos vencen"} en 15 días o menos.</p>}
    </div>
    {cards.length ? (
      <>
        <div id="business-card-grid" class="business-cards">
          {cards.map((business) => (
            <a
              class="business-card"
              href={`/admin/${business.id}`}
              data-business-card
              data-business-name={business.display_name}
              style={`--business-accent: ${business.accent}`}
              aria-label={`Abrir ${business.display_name}. ${business.contractDate ? `Fin del período: ${business.contractDate}` : "Sin fecha contractual registrada"}`}
            >
              <div class="business-head">
                <span class="business-logo" aria-hidden="true">
                  <span class="logo-fallback">{business.display_name.trim().slice(0, 1).toUpperCase()}</span>
                  {business.logo_url?.startsWith("https://") && <img class="logo-image" src={business.logo_url} alt="" loading="lazy" decoding="async" width="70" height="70" />}
                </span>
                <span class="business-identity">
                  <strong class="business-name">{business.display_name}</strong>
                  <span class="business-domain">/b/{business.slug}</span>
                </span>
                <span class="card-arrow" aria-hidden="true">→</span>
              </div>
              <div class="business-footer">
                <span class="contract-info">
                  <small>Renovación / fin del período</small>
                  <strong>{business.contractDate ?? "Sin fecha registrada"}</strong>
                  <small>{business.contract.label}</small>
                </span>
                <span class:list={["business-status", { "status-inactive": !business.is_active }]}>
                  {business.cancelled_at ? "Cancelado" : business.is_active ? "Activo" : "Inactivo"}
                </span>
              </div>
            </a>
          ))}
        </div>
        <p id="search-empty" class="search-empty" hidden role="status">No hay negocios con ese nombre.</p>
      </>
    ) : (
      <div class="empty card"><p>No hay negocios registrados.</p><a class="button" href="#nuevo-negocio">Agregar el primero</a></div>
    )}
    <p class="contract-help">La fecha indicada corresponde al fin del período contractual registrado; no representa el próximo cobro mensual ni confirma una renovación automática.</p>
  </section>

  <details id="nuevo-negocio" class="card form-card">
    <summary>Agregar negocio</summary>
    <div class="new-business-body">
      <h2>Crear negocio</h2>
      <p class="muted">Completa los datos del negocio para obtener su enlace NFC.</p>
      <form action="/api/admin/businesses" method="post">
        <div class="split">
          <div class="field"><label for="displayName">Nombre del negocio</label><input id="displayName" name="displayName" required minlength="2" maxlength="100" placeholder="Arepas Sabrosas" /><small class="hint">Como lo conocen sus clientes.</small></div>
          <div class="field"><label for="slug">Dirección web del negocio</label><input id="slug" name="slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" title="Solo minúsculas, números y guiones, sin espacios. Ejemplo: arepas-sabrosas" placeholder="arepas-sabrosas" autocapitalize="none" autocomplete="off" spellcheck="false" /><small class="hint">Se verá así: {siteUrl}/b/<strong id="slug-preview">arepas-sabrosas</strong>. Se llena sola con el nombre.</small></div>
        </div>
        <div class="field"><label for="legalName">Nombre legal de la empresa (opcional)</label><input id="legalName" name="legalName" maxlength="160" /><small class="hint">El nombre con el que está registrada (ej. Arepas Sabrosas LLC). Déjalo vacío si no tiene.</small></div>
        <div class="field"><label for="ownerEmail">Correo de quien entrará al panel (opcional)</label><input id="ownerEmail" name="ownerEmail" type="email" autocomplete="off" /><small class="hint">Le llega una invitación para crear su contraseña. También puedes invitarlo después.</small></div>
        <div class="split">
          <div class="field"><label for="contactPhone">Teléfono del negocio</label><input id="contactPhone" name="contactPhone" type="tel" inputmode="tel" autocomplete="off" placeholder="(305) 555-0100" /><small class="hint">Escríbelo normal, con código de área. Para otro país, empieza con +.</small></div>
          <div class="field"><label for="contactEmail">Correo del negocio</label><input id="contactEmail" name="contactEmail" type="email" /></div>
        </div>
        <p class="muted">Sus clientes ven estos datos en el aviso de privacidad. Pon al menos uno antes de registrar la aprobación del dueño.</p>
        <div class="field"><label for="logoUrl">Enlace del logo (opcional)</label><input id="logoUrl" name="logoUrl" type="url" /><small class="hint">Pega la dirección web directa de la imagen (empieza con https:// y suele terminar en .png o .jpg). No se puede subir el archivo aquí. Si lo dejas vacío se usan las iniciales del negocio.</small></div>
        <div class="field"><label for="privacyUrl">Aviso de privacidad propio (opcional)</label><input id="privacyUrl" name="privacyUrl" placeholder="https://minegocio.com/privacidad" /><small class="hint">Solo un enlace, no un archivo. Si lo dejas vacío se usa el aviso de Smart Tap, que ya viene listo.</small></div>
        <BrandColorField value="#155EEF" />
        <div class="field"><label for="inactivityDays">¿Cuántos días sin venir para considerarlo inactivo?</label><input id="inactivityDays" name="inactivityDays" type="number" min="7" max="365" value="30" /><small class="hint">Pasado ese tiempo, el cliente aparece como «no ha vuelto» en el panel. El dueño puede ajustarlo.</small></div>
        <div class="split">
          <div class="field"><label for="timezone">Zona horaria del negocio</label><select id="timezone" name="timezone" required>{timezoneOptions("America/New_York").map((option) => <option value={option.value} selected={option.value === "America/New_York"}>{option.label}</option>)}</select></div>
          <div class="field"><label for="defaultCountry">País de los teléfonos de sus clientes</label><select id="defaultCountry" name="defaultCountry" required>{countries.map((option) => <option value={option.value} selected={option.value === "US"}>{option.label}</option>)}</select><small class="hint">Sirve para entender teléfonos escritos sin código de país.</small></div>
        </div>
        <button class="button" type="submit">Crear negocio</button>
      </form>
    </div>
  </details>
</Base>

<script>
  import { slugify } from "../../lib/slug";
  import { initBrandColorField } from "../../lib/brand-color-field";
  const nameInput = document.querySelector<HTMLInputElement>("#displayName");
  const slugInput = document.querySelector<HTMLInputElement>("#slug");
  const slugPreview = document.querySelector<HTMLElement>("#slug-preview");
  if (nameInput && slugInput) {
    const showPreview = () => { if (slugPreview) slugPreview.textContent = slugInput.value || "arepas-sabrosas"; };
    let slugEditedByHand = false;
    slugInput.addEventListener("input", () => { slugEditedByHand = slugInput.value !== ""; showPreview(); });
    slugInput.addEventListener("blur", () => { slugInput.value = slugify(slugInput.value); showPreview(); });
    nameInput.addEventListener("input", () => { if (!slugEditedByHand) slugInput.value = slugify(nameInput.value); showPreview(); });
  }
  initBrandColorField();
  const search = document.querySelector<HTMLInputElement>("#business-search");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-business-card]"));
  const count = document.querySelector<HTMLElement>("#filtered-count");
  const searchEmpty = document.querySelector<HTMLElement>("#search-empty");
  const normalizeName = (value: string) => value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLocaleLowerCase().trim();
  const filter = () => {
    const query = normalizeName(search?.value ?? "");
    let visible = 0;
    cards.forEach((card) => {
      const matches = normalizeName(card.dataset.businessName ?? "").includes(query);
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (count) count.textContent = String(visible);
    if (searchEmpty) searchEmpty.hidden = visible !== 0;
  };
  search?.addEventListener("input", filter);
  document.querySelectorAll<HTMLImageElement>(".logo-image").forEach((img) => img.addEventListener("error", () => img.remove()));
  const newBusiness = document.querySelector<HTMLDetailsElement>("#nuevo-negocio");
  const showNewBusiness = () => {
    if (window.location.hash === "#nuevo-negocio" && newBusiness) {
      newBusiness.open = true;
      newBusiness.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  };
  window.addEventListener("hashchange", showNewBusiness);
  showNewBusiness();
</script>

<style>
  .page-head { display:flex; justify-content:space-between; align-items:end; gap:24px; margin-bottom:24px; }
  .page-head h1 { font-size:clamp(2rem,4vw,2.75rem); margin:6px 0 10px; }
  .page-head .muted { margin-bottom:0; }
  .search-area { display:grid; gap:7px; width:min(100%,350px); flex-shrink:0; }
  .search-area label { color:#344054; font-size:.88rem; font-weight:750; }
  .search-box { display:flex; align-items:center; gap:9px; min-height:48px; padding:0 14px; border:1px solid #D0D5DD; background:#fff; border-radius:12px; color:#667085; }
  .search-box:focus-within { outline:2px solid #0052CC; outline-offset:2px; }
  .search-box input { flex:1; min-width:0; border:0; outline:0; background:transparent; padding:10px 0; font:inherit; color:#0A0E1A; }
  .business-section { scroll-margin-top:24px; }
  .section-head { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-bottom:16px; }
  .section-head h2 { font-size:1.17rem; margin:0 0 4px; }
  .section-head .muted { font-size:.85rem; margin:0; }
  .expiry-note { background:#EAF2FF; color:#003DA5; border-left:3px solid #0052CC; padding:9px 12px; border-radius:8px; font-size:.83rem; margin:0; }
  .business-cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
  .business-card { display:grid; grid-template-rows:1fr auto; min-width:0; min-height:192px; padding:19px 20px; background:#fff; border:1px solid #E4E7EC; border-left:5px solid var(--business-accent); border-radius:16px; text-decoration:none; box-shadow:0 5px 18px #0A0E1A0A; transition:border-color .15s,box-shadow .15s,transform .15s; }
  .business-card:hover { box-shadow:0 8px 24px #0A0E1A1A; transform:translateY(-2px); border-top-color:#0052CC; border-right-color:#0052CC; border-bottom-color:#0052CC; }
  .business-card:focus-visible { outline:3px solid #0052CC; outline-offset:3px; }
  .business-card[hidden] { display:none; }
  .business-head { display:flex; align-items:center; gap:14px; min-width:0; }
  .business-logo { position:relative; flex:0 0 70px; width:70px; height:70px; border:1px solid #E4E7EC; border-radius:13px; overflow:hidden; display:grid; place-items:center; background:#F4F6FA; }
  .logo-fallback { font-weight:800; font-size:1.7rem; color:#003DA5; }
  .logo-image { position:absolute; inset:0; width:100%; height:100%; object-fit:contain; padding:5px; background:#fff; }
  .business-identity { display:grid; gap:6px; min-width:0; }
  .business-name { font-size:1.13rem; line-height:1.25; color:#0A0E1A; overflow-wrap:anywhere; }
  .business-domain { color:#667085; font-size:.81rem; overflow-wrap:anywhere; }
  .card-arrow { margin-left:auto; color:#0052CC; font-size:1.3rem; flex:0 0 auto; }
  .business-footer { display:flex; justify-content:space-between; align-items:end; gap:12px; border-top:1px solid #EAECF0; margin-top:17px; padding-top:13px; }
  .contract-info { display:grid; gap:5px; }
  .contract-info small { color:#667085; font-size:.76rem; }
  .contract-info strong { color:#0A0E1A; font-size:.94rem; }
  .business-status { align-self:start; flex:0 0 auto; border:1px solid #0052CC; background:#EFF5FF; color:#003DA5; border-radius:50px; padding:5px 9px; font-size:.72rem; font-weight:750; }
  .business-status.status-inactive { color:#475467; border-color:#D0D5DD; background:#F4F6FA; }
  .search-empty { padding:26px 14px; text-align:center; font-weight:650; }
  .contract-help { margin:18px 0 30px; font-size:.8rem; color:#667085; }
  #nuevo-negocio { scroll-margin-top:22px; margin-top:28px; }
  .form-card { padding:0; overflow:hidden; }
  .form-card > summary { cursor:pointer; padding:18px 24px; font-size:1.05rem; font-weight:800; color:#0052CC; }
  .form-card > summary:focus-visible { outline:3px solid #0052CC; outline-offset:-4px; }
  .new-business-body { padding:8px 24px 28px; }
  .new-business-body h2 { margin-bottom:9px; }
  .new-business-body form { display:grid; gap:17px; margin-top:22px; }
  .hint { color:#667085; font-size:.82rem; }
  .split { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  #nuevo-negocio input[type="color"] { padding:5px; }
  .empty { padding:28px; display:grid; gap:12px; justify-items:start; }
  @media(max-width:860px) { .business-cards { grid-template-columns:1fr; } }
  @media(max-width:660px) { .page-head { flex-direction:column; align-items:stretch; } .search-area { width:100%; } .section-head { align-items:start; flex-direction:column; } .business-card { min-height:180px; } .split { grid-template-columns:1fr; } }
</style>
