  .preview-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 16px; }
  .preview-tabs button { min-height: 44px; border-radius: 9px; border: 1px solid #d0d5dd; background: #fff; font-weight: 750; cursor: pointer; }
  .preview-tabs button[aria-selected="true"] { color: #fff; background: #0052CC; border-color: #0052CC; }
  .preview-pane[hidden], [hidden]#discard-ceo-edit, [hidden]#enable-ceo-edit { display: none !important; }
  .preview-pane > p { line-height: 1.5; }
