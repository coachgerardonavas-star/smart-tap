---
import Base from "../../layouts/Base.astro";
import { requirePlatformAdmin } from "../../lib/auth";
import { siteUrl as configuredSiteUrl } from "../../lib/env";
import { createSupabaseServiceClient } from "../../lib/supabase";
import type { Business } from "../../lib/types";
import { TERMS_VERSION } from "../../lib/terms";
import { customerThemePaletteNames, customerThemePalettes, customerThemes, isCustomerTheme } from "../../lib/customer-theme";
import BrandColorField from "../../components/BrandColorField.astro";
import { countryOptions, timezoneOptions } from "../../lib/regions";
import { businessPresets, businessTypes, resolveBusinessType, stockPhotoLibrary } from "../../lib/business-presets";

await requirePlatformAdmin(Astro.request, Astro.cookies);
const id = Astro.params.id ?? "";
const service = createSupabaseServiceClient();
const [businessResult, tagsResult, membersResult, signaturesResult, untaggedResult, customerCountResult, visitCountResult] = await Promise.all([
  service.from("businesses").select("*").eq("id", id).maybeSingle(),
  service.from("nfc_tags").select("*").eq("business_id", id).order("created_at"),
  service.from("business_members").select("user_id,role,is_active,created_at").eq("business_id", id).order("created_at"),
  service.from("terms_signatures").select("signed_at,user_id").eq("business_id", id).eq("terms_version", TERMS_VERSION).order("signed_at", { ascending: false }),
  service.from("visits").select("id", { count: "exact", head: true }).eq("business_id", id).eq("untagged", true),
  service.from("customers").select("id", { count: "exact", head: true }).eq("business_id", id),
  service.from("visits").select("id", { count: "exact", head: true }).eq("business_id", id),
]);
if (businessResult.error || !businessResult.data) return Astro.redirect("/admin?error=Negocio%20no%20encontrado", 302);
if (tagsResult.error || membersResult.error || signaturesResult.error || untaggedResult.error || customerCountResult.error || visitCountResult.error) throw tagsResult.error || membersResult.error || signaturesResult.error || untaggedResult.error || customerCountResult.error || visitCountResult.error;
const business = businessResult.data as Business;
const tags = tagsResult.data ?? [];
const members = await Promise.all((membersResult.data ?? []).map(async (member) => {
  const result = await service.auth.admin.getUserById(member.user_id);
  return { ...member, email: result.data.user?.email ?? "Usuario sin correo" };
}));
const activeMemberCount = members.filter((member) => member.is_active).length;
const activeOwnerIds = new Set(members.filter((member) => member.is_active && member.role === "owner").map((member) => member.user_id));
const currentSignature = signaturesResult.data?.find((signature) => activeOwnerIds.has(signature.user_id)) ?? null;
const currentTermsApproved = business.owner_approved_terms_version === TERMS_VERSION;
const activationLocked = !business.is_active && (!currentSignature || !currentTermsApproved || Boolean(business.cancelled_at));
const untaggedVisits = untaggedResult.count ?? 0;
const canDelete = (customerCountResult.count ?? 0) === 0 && (visitCountResult.count ?? 0) === 0;
const currentTermDate = business.term_ends_at?.slice(0, 10) ?? "";
const minimumExtensionDate = new Date(Math.max(Date.now(), business.term_ends_at ? new Date(business.term_ends_at).getTime() : 0) + 86_400_000).toISOString().slice(0, 10);
const siteUrl = configuredSiteUrl();
const businessType = resolveBusinessType(business.business_type);
const currentTheme = isCustomerTheme(business.theme) ? business.theme : "calido";
const themeLabels = { elegante: "Elegante", calido: "Cálido", moderno: "Moderno", colorido: "Colorido" } as const;
const currentColor = business.primary_color.toUpperCase();
const countries = countryOptions();
const timezones = timezoneOptions(business.timezone);
const roleLabels: Record<string, string> = { owner: "Dueño", manager: "Gerente", viewer: "Consulta" };
const missingConfig: string[] = [];
if (!business.logo_url?.trim()) missingConfig.push("enlace del logo");
if (!business.contact_phone && !business.contact_email) missingConfig.push("teléfono o correo de contacto");
if (![business.offer_inactive, business.offer_birthday, business.offer_frequent, business.offer_new].every((offer) => offer?.trim())) missingConfig.push("las cuatro ofertas");
if (!business.google_review_url?.trim()) missingConfig.push("enlace de reseñas de Google");
if (!(business.inactivity_days >= 7 && business.inactivity_days <= 365)) missingConfig.push("días de inactividad (entre 7 y 365)");
const activationChecklist = [
  { label: "Hay un dueño asignado en «Personas con acceso» (rol Dueño)", done: activeOwnerIds.size > 0, href: "#acceso", hint: "" },
  { label: "El dueño firmó los Términos vigentes", done: Boolean(currentSignature), href: "#acceso", hint: `Debe entrar con su correo en ${siteUrl}/login. Tú no puedes firmar por él.` },
  { label: "Datos del negocio completos y guardados", done: missingConfig.length === 0, href: "#datos", hint: missingConfig.length ? `Falta: ${missingConfig.join(", ")}.` : "" },
  { label: "Aprobación del dueño registrada", done: currentTermsApproved, href: "#aprobacion", hint: "Se registra en «Aprobación para activar», cuando el dueño confirme." },
];
const checklistReady = activationChecklist.every((item) => item.done);
const heroIsStock = Boolean(business.hero_image_url && stockPhotoLibrary.includes(business.hero_image_url));
const heroCustom = business.hero_image_url && !heroIsStock ? business.hero_image_url : "";
const presetData = JSON.stringify(Object.fromEntries(businessTypes.map((type) => [type, businessPresets[type]])));
const message = Astro.url.searchParams.get("message");
const formError = Astro.url.searchParams.get("error");
---

<Base title={`${business.display_name} | Smart Tap`} privateArea isAdmin>
  <a class="back" href="/admin#negocios">← Inicio · negocios</a>
  <header class="page-head">
    <div><p class="eyebrow">Centro de control CEO</p><h1>{business.display_name}</h1><p class="muted">/b/{business.slug} · Las tres vistas están disponibles sin cambiar de sesión.</p></div>
    <a class="button secondary" href="/admin#negocios">Ver todos los negocios</a>
  </header>
  {message && <div class="alert success">{message}</div>}
  {formError && <div class="alert">{formError}</div>}

<nav class="workspace-tabs" aria-label="Secciones de la cuenta">
  <a href="#vista" class="workspace-tab" data-ceo-tab="vista" aria-current="page"><span aria-hidden="true">◎</span><span>Vista</span></a>
  <a href="#diseno" class="workspace-tab" data-ceo-tab="diseno"><span aria-hidden="true">◈</span><span>Diseño</span></a>
  <a href="#administracion" class="workspace-tab" data-ceo-tab="administracion"><span aria-hidden="true">▦</span><span>Administración</span></a>
  <a href="#accesos" class="workspace-tab" data-ceo-tab="accesos"><span aria-hidden="true">♙</span><span>Accesos</span></a>
</nav><section class="ceo-panel" id="ceo-vista" data-ceo-panel="vista">
<section class="card panel live-preview-panel" aria-labelledby="live-preview-title">
        <div class="live-preview-head">
          <div><p class="eyebrow">Vista 360°</p><h2 id="live-preview-title">Tres perspectivas, una sesión</h2></div>
          <span class="preview-status">Modo seguro</span>
        </div>
        <div class="preview-tabs" role="tablist" aria-label="Perspectiva">
          <button type="button" role="tab" id="ceo-tab" aria-controls="ceo-view" aria-selected="false" data-ceo-view="ceo">CEO</button>
          <button type="button" role="tab" id="owner-tab" aria-controls="owner-view" aria-selected="true" data-ceo-view="owner">Dueño</button>
          <button type="button" role="tab" id="customer-tab" aria-controls="customer-view" aria-selected="false" data-ceo-view="customer">Cliente final</button>
        </div>
        <div id="ceo-view" class="preview-pane" role="tabpanel" aria-labelledby="ceo-tab" hidden>
          <p>Estás viendo tu panel de CEO. A la izquierda tienes la configuración real del negocio, los controles de edición y las herramientas administrativas.</p>
          <a class="button secondary" href="#administracion" data-jump-tab="administracion">Abrir controles CEO</a>
        </div>
        <div id="owner-view" class="preview-pane" role="tabpanel" aria-labelledby="owner-tab">
          <p class="muted compact-note">Así ve el dueño sus datos. Sin entrar en su cuenta ni ejecutar acciones.</p>
          <nav class="owner-preview-nav" aria-label="Explorar panel del dueño">
   <button type="button" data-owner-tab="inicio" aria-pressed="true">Inicio</button>
   <button type="button" data-owner-tab="clientes" aria-pressed="false">Clientes</button>
   <button type="button" data-owner-tab="seguimiento" aria-pressed="false">Seguimiento</button>
   <button type="button" data-owner-tab="pagina" aria-pressed="false">Mi página</button>
  </nav><div class="owner-preview">
            <iframe id="owner-dashboard-preview" title="Panel del dueño en modo solo lectura" src={`/dashboard?business=${encodeURIComponent(business.slug)}&preview=owner`} sandbox="allow-same-origin" loading="lazy"></iframe>
          </div>
        </div>
        <div id="customer-view" class="preview-pane" role="tabpanel" aria-labelledby="customer-tab" hidden>
          <p class="muted compact-note">Live Preview de la página NFC real. Esta es la página publicada. Para cambiarla, entra en Diseño y activa edición.</p>
          <div class="phone-preview">
            <iframe id="view-customer-preview" title="Página NFC publicada" src={`/preview/${business.id}`} data-preview-base={`/preview/${business.id}`}></iframe>
          </div>
        </div>
      </section>
</section><section class="ceo-panel" id="ceo-diseno" data-ceo-panel="diseno" hidden>
<div class="section-heading"><p class="eyebrow">Diseño</p><h2>Cambia el aspecto sin publicarlo</h2></div>
<div class="settings-grid design-layout"><section class="card panel" id="datos">
<h2>Diseño de la página NFC</h2>
<div class="edit-toolbar">
        <button type="button" class="button" id="enable-ceo-edit">Activar edición</button>
        <button type="button" class="button secondary" id="discard-ceo-edit" hidden>Descartar cambios</button>
        <p id="ceo-edit-status" role="status">Solo visualización: el editor está bloqueado. El Live Preview sigue disponible.</p>
      </div>
<form id="business-config-form" action={`/api/admin/business/${business.id}/update`} method="post" inert>
<input type="hidden" name="mode" value="design" />
<div class="field"><label for="displayName">Nombre del negocio</label><input id="displayName" name="displayName" value={business.display_name} required maxlength="100" /><small class="hint">Como lo conocen sus clientes.</small></div>
<div class="field"><label for="logoUrl">Enlace del logo (necesario para activar)</label><input id="logoUrl" name="logoUrl" type="url" value={business.logo_url ?? ""} /><small class="hint">Pega la dirección web directa de la imagen (empieza con https:// y suele terminar en .png o .jpg). No se puede subir el archivo aquí. Sin este enlace no se puede registrar la aprobación del dueño.</small></div>
<fieldset class="customer-screen-settings">
          <legend>Pantalla del cliente</legend>
          <p class="muted compact-note">Esto es lo que ve el cliente del negocio cuando toca la tarjeta NFC. Míralo con el botón «Ver pantalla del cliente» de arriba.</p>
          <div class="field"><label for="businessType">Tipo de negocio</label><select id="businessType" name="businessType" required>
            {businessTypes.map((type) => <option value={type} selected={type === businessType}>{businessPresets[type].label}</option>)}
          </select></div>
          <p class="muted compact-note">Al elegir el tipo se sugieren el estilo, la frase, los beneficios, los días de inactividad, la foto y el color. Puedes cambiarlos antes de guardar.</p>
          <div class="field"><label for="theme">Estilo de la pantalla</label><select id="theme" name="theme" required>
            {customerThemes.map((value) => <option value={value} selected={value === currentTheme}>{themeLabels[value]}</option>)}
          </select><small class="hint">Cambia las letras, el fondo y el tono de la pantalla.</small></div>
          <BrandColorField value={currentColor}>
            <span class="field-label">Colores sugeridos para este estilo</span>
            {customerThemes.map((value) => (
              <div class="swatches" data-theme-palette={value} hidden={value !== currentTheme}>
                {customerThemePalettes[value].map((color) => (
                  <button type="button" class="swatch" data-color={color}><span class="chip" style={`background:${color}`}></span><span>{customerThemePaletteNames[color]}</span></button>
                ))}
              </div>
            ))}
          </BrandColorField>
          <div class="field"><label for="tagline">Frase del negocio (opcional)</label><input id="tagline" name="tagline" value={business.tagline ?? ""} maxlength="80" /><small class="hint">Una frase corta que aparece bajo el nombre. Máximo 80 letras.</small></div>
          <div class="field">
            <span class="field-label">Foto de portada</span>
            <div class="photo-grid">
              {businessTypes.map((type) => businessPresets[type].photos.map((photo) => (
                <label class="photo-option" data-photo-type={type} hidden={type !== businessType}>
                  <input type="radio" name="heroSource" value={photo} checked={business.hero_image_url === photo} />
                  <img src={photo} alt={`Foto de biblioteca: ${businessPresets[type].label}`} width="160" height="107" loading="lazy" decoding="async" />
                </label>
              )))}
            </div>
            <label class="toggle"><input type="radio" name="heroSource" value="custom" checked={Boolean(heroCustom)} /> Usar mi propia foto (enlace que empiece con https://)</label>
            <input id="heroImageCustom" name="heroImageCustom" type="url" value={heroCustom} maxlength="500" placeholder="https://..." aria-label="URL HTTPS de la foto propia" />
            <label class="toggle"><input type="radio" name="heroSource" value="none" checked={!business.hero_image_url} /> Sin foto (bloque de color)</label>
            <p class="muted compact-note">Fotos de Unsplash con licencia libre para uso comercial. Créditos en /stock/ATTRIBUTION.md.</p>
          </div>
          <p class="muted compact-note">Son tres razones para registrarse que se muestran en la pantalla. Escribe las tres o deja las tres vacías para usar los textos estándar.</p>
          <div class="field"><label for="benefit1">Beneficio 1</label><input id="benefit1" name="benefit1" value={business.benefits?.[0] ?? ""} maxlength="40" placeholder="Ofertas para clientes" /></div>
          <div class="field"><label for="benefit2">Beneficio 2</label><input id="benefit2" name="benefit2" value={business.benefits?.[1] ?? ""} maxlength="40" placeholder="Sorpresas en tu cumpleaños" /></div>
          <div class="field"><label for="benefit3">Beneficio 3</label><input id="benefit3" name="benefit3" value={business.benefits?.[2] ?? ""} maxlength="40" placeholder="Te reconocemos al volver" /></div>
          <div class="field"><label for="instagramUrl">Instagram del negocio (opcional)</label><input id="instagramUrl" name="instagramUrl" type="url" value={business.instagram_url ?? ""} maxlength="60" placeholder="https://www.instagram.com/usuario" pattern="https://www\.instagram\.com/[A-Za-z0-9._]{1,30}/?" title="Un enlace como https://www.instagram.com/usuario" /><small class="hint">Pega el enlace al perfil. En la pantalla aparece un botón «Seguir en Instagram».</small></div>
        </fieldset>
<script type="application/json" id="business-presets" set:html={presetData}></script>
<fieldset><legend>Mensajes de oferta por situación</legend><legend>Mensajes de oferta por situación</legend>
          <p class="muted compact-note">El dueño aprueba estos textos. Se incluyen en el WhatsApp que él mismo envía a sus clientes.</p>
          <div class="field"><label for="offerInactive">Cliente que no ha vuelto</label><input id="offerInactive" name="offerInactive" value={business.offer_inactive ?? ""} minlength="1" maxlength="200" /></div>
          <div class="field"><label for="offerBirthday">Cumpleaños</label><input id="offerBirthday" name="offerBirthday" value={business.offer_birthday ?? ""} minlength="1" maxlength="200" /></div>
          <div class="field"><label for="offerFrequent">Cliente frecuente</label><input id="offerFrequent" name="offerFrequent" value={business.offer_frequent ?? ""} minlength="1" maxlength="200" /></div>
          <div class="field"><label for="offerNew">Cliente nuevo</label><input id="offerNew" name="offerNew" value={business.offer_new ?? ""} minlength="1" maxlength="200" /></div>
        </fieldset>
<button class="button" type="submit">Guardar y publicar cambios</button>
</form></section><div class="side-stack"><section class="card panel live-preview-panel">
<div class="live-preview-head"><div><p class="eyebrow">Diseño</p><h2>Live Preview NFC</h2></div><span class="preview-status">Sin publicar</span></div>
<p class="muted compact-note">Los cambios se muestran aquí mientras editas. Los clientes no los ven hasta guardar.</p>
<div class="phone-preview"><iframe id="customer-live-preview" title="Live Preview de edición" src={`/preview/${business.id}`} data-preview-base={`/preview/${business.id}`}></iframe></div>
</section></div></div></section><section class="ceo-panel" id="ceo-administracion" data-ceo-panel="administracion" hidden>
<div class="section-heading"><p class="eyebrow">Administración</p><h2>Todo lo administrativo, en su lugar</h2><p class="muted">Abre solamente lo que necesitas revisar.</p></div>
<div class="modules-grid">
<details class="admin-module card" id="contrato" ><summary><span class="module-icon" aria-hidden="true">▦</span><span class="module-name"><strong>Plan y vigencia</strong><small>Contrato y extensión</small></span><span aria-hidden="true">⌄</span></summary><div class="module-body"><section class="card panel">
        <h2>Plazo del servicio</h2>
        {business.term_ends_at
          ? <p class="approval-state"><strong>Vence el {new Intl.DateTimeFormat("es-US", { dateStyle: "long" }).format(new Date(business.term_ends_at))}</strong><span>Smart Tap no suspende el negocio de forma automática al vencer.</span></p>
          : <p class="muted">El plazo inicial se fija al activar el negocio por primera vez.</p>}
        <form action={`/api/admin/business/${business.id}/term-extension`} method="post">
          <div class="field"><label for="termEndsAt">Nueva fecha de vencimiento</label><input id="termEndsAt" name="termEndsAt" type="date" value={currentTermDate} min={minimumExtensionDate} required /></div>
          <label class="toggle"><input name="annexSigned" type="checkbox" required /> Anexo de Extensión firmado</label>
          <button class="button secondary" type="submit">Registrar extensión</button>
        </form>
      </section></div></details>
<details class="admin-module card" id="servicio" ><summary><span class="module-icon" aria-hidden="true">⚙</span><span class="module-name"><strong>Estado del negocio</strong><small>Contacto, privacidad y activación</small></span><span aria-hidden="true">⌄</span></summary><div class="module-body"><section class="card panel" id="ajustes-negocio"><h2>Datos y estado</h2>
<div class="edit-toolbar"><button class="button" type="button" id="enable-admin-edit">Editar ajustes</button><button class="button secondary" type="button" id="discard-admin-edit" hidden>Descartar cambios</button><p id="admin-edit-status" role="status">Solo lectura. Activa edición para realizar ajustes.</p></div>
<form id="business-admin-form" action={`/api/admin/business/${business.id}/update`} method="post" inert>
<input type="hidden" name="mode" value="administration" />
<div class="field"><label for="legalName">Nombre legal (opcional)</label><input id="legalName" name="legalName" value={business.legal_name ?? ""} /></div>
<div class="field"><label for="slug">Dirección web del negocio</label><input id="slug" name="slug" value={business.slug} required /><small class="hint">Si ya grabaste tarjetas NFC, no cambies este enlace: las tarjetas apuntan aquí.</small></div>
<div class="field"><label for="privacyUrl">Aviso de privacidad (opcional)</label><input id="privacyUrl" name="privacyUrl" value={business.privacy_url ?? ""} placeholder={`/privacy/${business.slug}`} /></div>
<div class="split">
  <div class="field"><label for="contactPhone">Teléfono del negocio</label><input id="contactPhone" name="contactPhone" type="tel" value={business.contact_phone ?? ""} placeholder="(305) 555-0100" /></div>
  <div class="field"><label for="contactEmail">Correo del negocio</label><input id="contactEmail" name="contactEmail" type="email" value={business.contact_email ?? ""} /></div>
</div>
<div class="field"><label for="inactivityDays">Días para considerar inactivo</label><input id="inactivityDays" name="inactivityDays" type="number" min="7" max="365" value={business.inactivity_days} /></div>
<div class="split">
  <div class="field"><label for="timezone">Zona horaria</label><select id="timezone" name="timezone" required>{timezones.map((option) => <option value={option.value} selected={option.value === business.timezone}>{option.label}</option>)}</select></div>
  <div class="field"><label for="defaultCountry">País de los teléfonos</label><select id="defaultCountry" name="defaultCountry" required>{countries.map((option) => <option value={option.value} selected={option.value === business.default_country}>{option.label}</option>)}</select></div>
</div>
<fieldset><legend>Reseñas de Google</legend><legend>Enlace de reseñas de Google</legend>
          <div class="field"><label for="googleReviewUrl">Enlace directo para dejar una reseña</label><input id="googleReviewUrl" name="googleReviewUrl" type="url" value={business.google_review_url ?? ""} placeholder="https://g.page/r/.../review" /><small class="hint">Se graba en una tarjeta NFC aparte para pedir reseñas. También aparece como botón al terminar el registro.</small></div>
        </fieldset>
{!business.is_active && (
  <div class="checklist" id="antes-de-activar">
    <strong>Para activar el negocio:</strong>
    <ul>{activationChecklist.map((item) => <li class:list={{ done:item.done }}><span aria-hidden="true">{item.done ? "✓" : "○"}</span><div><a href={item.href}>{item.label}</a>{!item.done && item.hint && <small>{item.hint}</small>}</div></li>)}</ul>
  </div>
)}
<label class="toggle"><input name="isActive" type="checkbox" checked={business.is_active} disabled={activationLocked} /> Negocio activo</label>
{!business.is_active && !currentSignature && <p class="muted"><strong>Por qué no se puede marcar:</strong> el dueño aún no ha firmado los Términos. Tú no puedes firmar por él. Pídele que entre a {siteUrl}/login.</p>}
{!business.is_active && currentSignature && !currentTermsApproved && <p class="muted"><strong>Por qué no se puede marcar:</strong> falta registrar la aprobación del dueño en Accesos.</p>}
{business.cancelled_at && <p class="alert">El servicio fue cancelado y no puede reactivarse.</p>}
<button class="button" type="submit">Guardar ajustes</button>
</form></section></div></details>
<details class="admin-module card" id="nfc" ><summary><span class="module-icon" aria-hidden="true">◉</span><span class="module-name"><strong>Tarjetas NFC</strong><small>Enlaces y configuración</small></span><span aria-hidden="true">⌄</span></summary><div class="module-body"><section class="card panel">
        <h2>NFC y enlaces</h2>
        <p class="muted compact-note">Cada tarjeta NFC tiene su propio enlace: ese es el que se graba en la tarjeta.</p>
        <p class="metric-line"><strong>Visitas sin tarjeta NFC reconocida</strong><span>{untaggedVisits}</span></p>
        <div class="review-link">
          <strong>Enlace de reseñas de Google (para grabar en una tarjeta NFC)</strong>
          {business.google_review_url
            ? <span data-copy-source><a href={business.google_review_url} target="_blank" rel="noreferrer">{business.google_review_url}</a></span>
            : <span class="muted">Pendiente de configurar.</span>}
          {business.google_review_url && <button type="button" class="button secondary copy-link" data-copy>Copiar enlace</button>}
        </div>
        <ul class="records">{tags.map((tag) => <li><div><strong>{tag.label}</strong><small class="tag-link" data-copy-source>{siteUrl}/b/{business.slug}?t={tag.code}</small><button type="button" class="button secondary copy-link" data-copy>Copiar enlace</button></div><div class="status"><span class:list={["pill", { off: !tag.is_active }]}>{tag.is_active ? "Activo" : "Pausado"}</span><form action={`/api/admin/business/${business.id}/tag-status`} method="post"><input type="hidden" name="targetId" value={tag.id} /><input type="hidden" name="active" value={tag.is_active ? "false" : "true"} /><button class="link-button" type="submit">{tag.is_active ? "Pausar" : "Activar"}</button></form></div></li>)}</ul>
        <form class="inline-form" action={`/api/admin/business/${business.id}/tag`} method="post"><div class="field"><label for="label">Nombre de la nueva tarjeta NFC</label><input id="label" name="label" placeholder="Mesa 2" required /></div><button class="button secondary" type="submit">Crear tarjeta</button></form>
      </section></div></details>
<details class="admin-module card" id="cancelacion" ><summary><span class="module-icon" aria-hidden="true">!</span><span class="module-name"><strong>Cancelación y exportación</strong><small>Acciones delicadas</small></span><span aria-hidden="true">⌄</span></summary><div class="module-body"><section class="card panel danger-zone">
        <h2>Cancelación y copia de clientes</h2>
        <p class="muted">Descarga la copia del negocio antes de cancelar. El archivo contiene nombre, teléfono, cumpleaños, visitas y permiso de WhatsApp.</p>
        <form action={`/api/admin/business/${business.id}/export.csv`} method="post"><button class="button secondary" type="submit">Descargar CSV</button></form>
        {business.cancelled_at ? (
          <p class="approval-state"><strong>Servicio cancelado</strong><span>{new Intl.DateTimeFormat("es-US", { dateStyle: "medium", timeStyle: "short" }).format(new Date(business.cancelled_at))}</span><span>Los datos de clientes se borran al cumplir 30 días.</span></p>
        ) : (
          <form action={`/api/admin/business/${business.id}/cancel`} method="post" onsubmit="return confirm('¿Cancelar el servicio? El negocio se desactiva ahora y los datos de clientes se borran a los 30 días.')">
            <button class="button danger" type="submit">Cancelar servicio</button>
          </form>
        )}
        {canDelete ? (
          <form class="delete-form" action={`/api/admin/business/${business.id}/delete`} method="post" onsubmit="return confirm('¿Eliminar este negocio para siempre? No se puede deshacer.')">
            <h3>Eliminar negocio (solo pruebas o errores)</h3>
            <p class="muted">Borra el negocio, sus tarjetas NFC y sus accesos. Solo aparece si todavía no tiene clientes ni visitas. Los usuarios no se borran.</p>
            <div class="field"><label for="confirmSlug">Para confirmar, escribe su dirección web: <strong>{business.slug}</strong></label><input id="confirmSlug" name="confirmSlug" required autocomplete="off" autocapitalize="none" spellcheck="false" /></div>
            <button class="button danger" type="submit">Eliminar negocio</button>
          </form>
        ) : (
          <p class="muted">Este negocio ya tiene clientes o visitas, por eso no se puede eliminar. Usa «Cancelar servicio».</p>
        )}
      </section></div></details>
</div></section><section class="ceo-panel" id="ceo-accesos" data-ceo-panel="accesos" hidden>
<div class="section-heading"><p class="eyebrow">Accesos</p><h2>Personas y aprobaciones</h2><p class="muted">Invita usuarios y consulta las autorizaciones.</p></div>
<div class="modules-grid">
<details class="admin-module card" id="personal" open><summary><span class="module-icon" aria-hidden="true">♙</span><span class="module-name"><strong>Personas con acceso</strong><small>Roles y permisos</small></span><span aria-hidden="true">⌄</span></summary><div class="module-body"><section class="card panel" id="acceso">
        <h2>Personas con acceso: {activeMemberCount} de 2</h2>
        <p class="muted compact-note">Cada negocio puede tener hasta 2 personas. Dueño y Gerente pueden escribir a los clientes y eliminarlos; Consulta solo mira. Quien firma los Términos debe ser Dueño.</p>
        {members.length ? <ul class="records">{members.map((member) => <li><div><strong>{member.email}</strong><small>{roleLabels[member.role] ?? member.role}</small></div><div class="status"><span class:list={["pill", { off: !member.is_active }]}>{member.is_active ? "Activo" : "Pausado"}</span><form action={`/api/admin/business/${business.id}/member-status`} method="post"><input type="hidden" name="targetId" value={member.user_id} /><input type="hidden" name="active" value={member.is_active ? "false" : "true"} /><button class="link-button" type="submit">{member.is_active ? "Pausar" : "Activar"}</button></form></div></li>)}</ul> : <p class="muted">Aún no hay usuarios asignados.</p>}
        <form class="inline-form member" action={`/api/admin/business/${business.id}/invite`} method="post"><div class="field"><label for="email">Correo de la persona</label><input id="email" name="email" type="email" required /></div><div class="field"><label for="role">Qué puede hacer</label><select id="role" name="role"><option value="owner">Dueño (administra y firma)</option><option value="manager">Gerente (escribe a clientes)</option><option value="viewer">Consulta (solo mira)</option></select></div><button class="button secondary" type="submit">Invitar</button></form>
      </section></div></details>
<details class="admin-module card" id="firmas" ><summary><span class="module-icon" aria-hidden="true">✓</span><span class="module-name"><strong>Firma y aprobación</strong><small>Requisitos para activar</small></span><span aria-hidden="true">⌄</span></summary><div class="module-body"><section class="card panel" id="aprobacion">
        <h2>Aprobación para activar</h2>
        <p class="muted compact-note">La lista completa de requisitos está arriba del cuadro «Negocio activo».</p>
        {currentSignature
          ? <p class="approval-state"><strong>Términos firmados</strong><span>{new Intl.DateTimeFormat("es-US", { dateStyle: "medium", timeStyle: "short" }).format(new Date(currentSignature.signed_at))}</span></p>
          : <p class="alert">Falta que un dueño firme los Términos de servicio (versión {TERMS_VERSION}).</p>}
        {business.owner_approved_at
          ? <p class="approval-state"><strong>Aprobado por {business.owner_approved_name}</strong><span>{new Intl.DateTimeFormat("es-US", { dateStyle: "medium", timeStyle: "short" }).format(new Date(business.owner_approved_at))}</span></p>
          : <p class="muted">El dueño debe aprobar la configuración final antes de activar el negocio.</p>}
        {message && <div class="alert success">{message}</div>}
        {formError && <div class="alert">{formError}</div>}
        {!currentSignature && <p class="muted compact-note"><strong>El botón está apagado</strong> porque el dueño aún no ha firmado los Términos. Se enciende solo cuando firme.</p>}
        <form class="inline-form" action={`/api/admin/business/${business.id}/approve`} method="post">
          <div class="field"><label for="ownerName">Nombre del dueño que te confirmó que todo está bien</label><input id="ownerName" name="ownerName" minlength="2" maxlength="120" required /></div>
          <button class="button secondary" type="submit" disabled={!currentSignature}>Registrar aprobación del dueño</button>
        </form>
      </section></div></details>
</div></section>
</Base>

<script>
  import { initBrandColorField } from "../../lib/brand-color-field";
  initBrandColorField();
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const source = button.parentElement?.querySelector<HTMLElement>("[data-copy-source]");
      const text = source?.textContent?.trim() ?? "";
      if (!text) return;
      const original = button.textContent;
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = "¡Copiado!";
      } catch {
        const range = document.createRange();
        range.selectNodeContents(source!);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        button.textContent = "Selecciónalo y copia";
      }
      setTimeout(() => { button.textContent = original; }, 2500);
    });
  });
  type Preset = { theme: string; tagline: string; benefits: string[]; inactivityDays: number; photos: string[] };
  const presets = JSON.parse(document.getElementById("business-presets")?.textContent || "{}") as Record<string, Preset>;
  const form = document.querySelector<HTMLFormElement>("#business-config-form");
  const typeSelect = document.querySelector<HTMLSelectElement>("#businessType");
  const themeSelect = document.querySelector<HTMLSelectElement>("#theme");
  const previewFrame = document.querySelector<HTMLIFrameElement>("#customer-live-preview");
  const editButton = document.querySelector<HTMLButtonElement>("#enable-ceo-edit");
  const discardButton = document.querySelector<HTMLButtonElement>("#discard-ceo-edit");
  const editStatus = document.querySelector<HTMLElement>("#ceo-edit-status");
  let editing = false;
  let dirty = false;
  let submitting = false;
  let activeView = "owner";
  const setEditMode = (enabled: boolean) => {
    editing = enabled;
    if (form) form.inert = !enabled;
    if (editButton) editButton.hidden = enabled;
    if (discardButton) discardButton.hidden = !enabled;
    if (editStatus) editStatus.textContent = enabled
      ? "Edición activada. Los cambios son privados hasta pulsar «Guardar y publicar cambios»."
      : "Solo visualización: el editor está bloqueado. El Live Preview sigue disponible.";
  };
  setEditMode(false);
  editButton?.addEventListener("click", () => setEditMode(true));
  const viewTabs = document.querySelectorAll<HTMLButtonElement>("[data-ceo-view]");
  viewTabs.forEach((tab) => tab.addEventListener("click", () => {
    activeView = tab.dataset.ceoView ?? "customer";
    viewTabs.forEach((item) => {
      const selected = item === tab;
      item.setAttribute("aria-selected", String(selected));
      item.tabIndex = selected ? 0 : -1;
      const pane = document.getElementById(`${item.dataset.ceoView}-view`);
      if (pane) pane.hidden = !selected;
    });

  }));
  window.addEventListener("beforeunload", (event) => {
    if (dirty && !submitting) { event.preventDefault(); event.returnValue = ""; }
  });
  form?.addEventListener("submit", (event) => {
    if (!editing) { event.preventDefault(); return; }
    submitting = true;
  });
  discardButton?.addEventListener("click", () => {
    if (dirty && !window.confirm("¿Descartar los cambios sin guardar?")) return;
    window.clearTimeout(previewTimer);
    form?.reset();
    if (themeSelect) showPalette(themeSelect.value, false);
    if (typeSelect) showPhotos(typeSelect.value);
    dirty = false;
    setEditMode(false);
    if (previewFrame) previewFrame.src = previewFrame.dataset.previewBase ?? "";
  });
  let previewTimer: number | undefined;
  function refreshPreview() {
    if (!form || !previewFrame) return;
    window.clearTimeout(previewTimer);
    previewTimer = window.setTimeout(() => {
      const params = new URLSearchParams();
      ["displayName", "businessType", "theme", "primaryColor", "tagline", "benefit1", "benefit2", "benefit3", "logoUrl", "instagramUrl"].forEach((name) => {
        const field = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
        if (field) params.set(name, field.value);
      });
      const heroChoice = form.querySelector<HTMLInputElement>('input[name="heroSource"]:checked')?.value ?? "none";
      const customHero = form.querySelector<HTMLInputElement>("#heroImageCustom")?.value ?? "";
      params.set("heroImageUrl", heroChoice === "custom" ? customHero : heroChoice === "none" ? "" : heroChoice);
      previewFrame.src = `${previewFrame.dataset.previewBase}?${params.toString()}`;
    }, 180);
  }
  const updated = () => { if (!editing) return; dirty = true; refreshPreview(); };
  form?.addEventListener("input", updated);
  form?.addEventListener("change", updated);
  form?.addEventListener("click", (event) => {
    if (editing && (event.target as Element).closest("[data-color]")) updated();
  });
  const setValue = (id: string, value: string) => { const input = form?.querySelector<HTMLInputElement>(`#${id}`); if (input) input.value = value; };
  function showPalette(theme: string, pickFirst: boolean) {
    form?.querySelectorAll<HTMLElement>("[data-theme-palette]").forEach((group) => {
      const active = group.dataset.themePalette === theme;
      group.hidden = !active;
    });
    if (!pickFirst) return;
    // Switch to the new style's first suggested color only when the current one is
    // itself a suggestion; a color typed by hand (the brand's own) is kept.
    const current = (form?.querySelector<HTMLInputElement>("#primaryColor")?.value ?? "").trim().toUpperCase();
    const suggested = Array.from(form?.querySelectorAll<HTMLElement>("[data-color]") ?? []).map((button) => (button.dataset.color ?? "").toUpperCase());
    if (!current || suggested.includes(current)) {
      form?.querySelector<HTMLElement>(`[data-theme-palette="${theme}"] [data-color]`)?.click();
    }
  }
  function showPhotos(type: string) {
    form?.querySelectorAll<HTMLElement>("[data-photo-type]").forEach((option) => { option.hidden = option.dataset.photoType !== type; });
  }
  themeSelect?.addEventListener("change", () => showPalette(themeSelect.value, true));
  typeSelect?.addEventListener("change", () => {
    const preset = presets[typeSelect.value];
    if (!preset || !themeSelect) return;
    themeSelect.value = preset.theme;
    showPalette(preset.theme, true);
    showPhotos(typeSelect.value);
    setValue("tagline", preset.tagline);
    preset.benefits.forEach((benefit, index) => setValue(`benefit${index + 1}`, benefit));
    setValue("inactivityDays", String(preset.inactivityDays));
    const photo = form?.querySelector<HTMLInputElement>(`input[name="heroSource"][value="${preset.photos[0]}"]`);
    if (photo) photo.checked = true;
    refreshPreview();
  });

  // Workspace navigation: same business, independent screens.
  const mainTabs = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-ceo-tab]"));
  const mainPanels = Array.from(document.querySelectorAll<HTMLElement>("[data-ceo-panel]"));
  const knownTabs = new Set(["vista","diseno","administracion","accesos"]);
  const changeWorkspaceTab = (requested: string, updateHash = true) => {
    const key = knownTabs.has(requested) ? requested : "vista";
    mainTabs.forEach((link) => {
      const selected = link.dataset.ceoTab === key;
      if (selected) link.setAttribute("aria-current","page");
      else link.removeAttribute("aria-current");
    });
    mainPanels.forEach((panel) => { panel.hidden = panel.dataset.ceoPanel !== key; });
    if (updateHash) window.history.replaceState(null,"", "#" + key);
  };
  mainTabs.forEach((link) => link.addEventListener("click",(event) => {
    event.preventDefault();
    changeWorkspaceTab(link.dataset.ceoTab ?? "vista");
    window.scrollTo({top:0,behavior:"instant"});
  }));
  document.querySelectorAll<HTMLAnchorElement>("[data-jump-tab]").forEach((link) => link.addEventListener("click",(event)=>{
    event.preventDefault(); changeWorkspaceTab(link.dataset.jumpTab ?? "vista");
  }));
  window.addEventListener("hashchange",()=>changeWorkspaceTab(window.location.hash.slice(1),false));
  changeWorkspaceTab(window.location.hash.slice(1),false);
  const ownerFrame = document.querySelector<HTMLIFrameElement>("#owner-dashboard-preview");
  const ownerNav = document.querySelectorAll<HTMLButtonElement>("[data-owner-tab]");
  ownerNav.forEach((button)=>button.addEventListener("click",()=>{
    ownerNav.forEach((item)=>item.setAttribute("aria-pressed",String(item===button)));
    if (!ownerFrame) return;
    const nextUrl = new URL(ownerFrame.src);
    nextUrl.searchParams.set("tab",button.dataset.ownerTab??"inicio");
    ownerFrame.src = nextUrl.toString();
  }));
  // Admin settings are separate from the protected design editor.
  const adminForm = document.querySelector<HTMLFormElement>("#business-admin-form");
  const adminEnable = document.querySelector<HTMLButtonElement>("#enable-admin-edit");
  const adminDiscard = document.querySelector<HTMLButtonElement>("#discard-admin-edit");
  const adminStatus = document.querySelector<HTMLElement>("#admin-edit-status");
  let adminEditing=false;
  let adminDirty=false;
  const setAdminEditing=(enabled:boolean)=>{
    adminEditing=enabled;
    if(adminForm)adminForm.inert=!enabled;
    if(adminEnable)adminEnable.hidden=enabled;
    if(adminDiscard)adminDiscard.hidden=!enabled;
    if(adminStatus)adminStatus.textContent=enabled?"Puedes editar; guardar confirma los ajustes.":"Solo lectura. Activa edición para realizar ajustes.";
  };
  setAdminEditing(false);
  adminEnable?.addEventListener("click",()=>setAdminEditing(true));
  adminForm?.addEventListener("input",()=>{if(adminEditing)adminDirty=true});
  adminForm?.addEventListener("change",()=>{if(adminEditing)adminDirty=true});
  adminDiscard?.addEventListener("click",()=>{
    if(adminDirty&&!window.confirm("¿Descartar los cambios administrativos sin guardar?"))return;
    adminForm?.reset();adminDirty=false;setAdminEditing(false);
  });
  adminForm?.addEventListener("submit",(event)=>{
    if(!adminEditing){event.preventDefault();return;}
    submitting=true;
  });
  window.addEventListener("beforeunload",(event)=>{
    if(adminDirty&&!submitting){event.preventDefault();event.returnValue="";}
  });
</script>

