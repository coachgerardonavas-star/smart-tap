---
import Base from "../../layouts/Base.astro";
import { requirePlatformAdmin } from "../../lib/auth";
import { siteUrl as configuredSiteUrl } from "../../lib/env";
import { createSupabaseServiceClient } from "../../lib/supabase";
import type { Business } from "../../lib/types";
import { TERMS_VERSION } from "../../lib/terms";
import { customerThemePaletteNames, customerThemePalettes, customerThemes, isCustomerTheme, isPaletteColor } from "../../lib/customer-theme";
import { businessPresets, businessTypes, resolveBusinessType, stockPhotoLibrary } from "../../lib/business-presets";

await requirePlatformAdmin(Astro.request, Astro.cookies);
const id = Astro.params.id ?? "";
const service = createSupabaseServiceClient();
const [businessResult, tagsResult, membersResult, signaturesResult, untaggedResult] = await Promise.all([
  service.from("businesses").select("*").eq("id", id).maybeSingle(),
  service.from("nfc_tags").select("*").eq("business_id", id).order("created_at"),
  service.from("business_members").select("user_id,role,is_active,created_at").eq("business_id", id).order("created_at"),
  service.from("terms_signatures").select("signed_at,user_id").eq("business_id", id).eq("terms_version", TERMS_VERSION).order("signed_at", { ascending: false }),
  service.from("visits").select("id", { count: "exact", head: true }).eq("business_id", id).eq("untagged", true),
]);
if (businessResult.error || !businessResult.data) return Astro.redirect("/admin?error=Negocio%20no%20encontrado", 302);
if (tagsResult.error || membersResult.error || signaturesResult.error || untaggedResult.error) throw tagsResult.error || membersResult.error || signaturesResult.error || untaggedResult.error;
const business = businessResult.data as Business;
const tags = tagsResult.data ?? [];
const members = await Promise.all((membersResult.data ?? []).map(async (member) => {
  const result = await service.auth.admin.getUserById(member.user_id);
  return { ...member, email: result.data.user?.email ?? "Usuario sin correo" };
}));
const activeMemberCount = members.filter((member) => member.is_active).length;
const activeOwnerIds = new Set(members.filter((member) => member.is_active && member.role === "owner").map((member) => member.user_id));
const currentSignature = signaturesResult.data?.find((signature) => activeOwnerIds.has(signature.user_id)) ?? null;
const currentTermsApproved = business.owner_approved_terms_version === TERMS_VERSION;
const activationLocked = !business.is_active && (!currentSignature || !currentTermsApproved || Boolean(business.cancelled_at));
const untaggedVisits = untaggedResult.count ?? 0;
const currentTermDate = business.term_ends_at?.slice(0, 10) ?? "";
const minimumExtensionDate = new Date(Math.max(Date.now(), business.term_ends_at ? new Date(business.term_ends_at).getTime() : 0) + 86_400_000).toISOString().slice(0, 10);
const siteUrl = configuredSiteUrl();
const businessType = resolveBusinessType(business.business_type);
const currentTheme = isCustomerTheme(business.theme) ? business.theme : "calido";
const themeLabels = { elegante: "Elegante", calido: "Cálido", moderno: "Moderno", colorido: "Colorido" } as const;
const currentColor = business.primary_color.toUpperCase();
const colorOffPalette = !isPaletteColor(currentTheme, currentColor);
const heroIsStock = Boolean(business.hero_image_url && stockPhotoLibrary.includes(business.hero_image_url));
const heroCustom = business.hero_image_url && !heroIsStock ? business.hero_image_url : "";
const presetData = JSON.stringify(Object.fromEntries(businessTypes.map((type) => [type, businessPresets[type]])));
const message = Astro.url.searchParams.get("message");
const formError = Astro.url.searchParams.get("error");
---

<Base title={`${business.display_name} | Smart Tap`} privateArea isAdmin>
  <a class="back" href="/admin">← Todos los negocios</a>
  <header class="page-head">
    <div><p class="eyebrow">Configuración</p><h1>{business.display_name}</h1><p class="muted">/b/{business.slug}</p></div>
    <a class="button secondary" href={`/b/${business.slug}`} target="_blank">Abrir landing</a>
  </header>
  {message && <div class="alert success">{message}</div>}
  {formError && <div class="alert">{formError}</div>}

  <div class="settings-grid">
    <section class="card panel">
      <h2>Datos y marca</h2>
      <form action={`/api/admin/business/${business.id}/update`} method="post">
        <div class="split"><div class="field"><label for="displayName">Nombre</label><input id="displayName" name="displayName" value={business.display_name} required /></div><div class="field"><label for="slug">URL corta</label><input id="slug" name="slug" value={business.slug} required /></div></div>
        <div class="field"><label for="legalName">Razón social</label><input id="legalName" name="legalName" value={business.legal_name ?? ""} /></div>
        <div class="field"><label for="logoUrl">URL del logo</label><input id="logoUrl" name="logoUrl" type="url" value={business.logo_url ?? ""} /></div>
        <fieldset class="customer-screen-settings">
          <legend>Pantalla del cliente</legend>
          <div class="field"><label for="businessType">Tipo de negocio</label><select id="businessType" name="businessType" required>
            {businessTypes.map((type) => <option value={type} selected={type === businessType}>{businessPresets[type].label}</option>)}
          </select></div>
          <p class="muted compact-note">Al cambiar el tipo se rellenan el estilo, la frase, los beneficios, los días de inactividad, la foto y el color sugeridos. Puedes editarlos antes de guardar.</p>
          <div class="field"><label for="theme">Estilo</label><select id="theme" name="theme" required>
            {customerThemes.map((value) => <option value={value} selected={value === currentTheme}>{themeLabels[value]}</option>)}
          </select></div>
          <div class="field">
            <span class="field-label">Color de acento</span>
            {colorOffPalette && <p class="muted compact-note">El color actual {currentColor} no está en la paleta del estilo. Elige uno antes de guardar.</p>}
            {customerThemes.map((value) => (
              <div class="swatches" data-theme-palette={value} hidden={value !== currentTheme}>
                {customerThemePalettes[value].map((color) => (
                  <label class="swatch"><input type="radio" name="primaryColor" value={color} checked={value === currentTheme && color === currentColor} disabled={value !== currentTheme} required /><span class="chip" style={`background:${color}`}></span><span>{customerThemePaletteNames[color]}</span></label>
                ))}
              </div>
            ))}
          </div>
          <div class="field"><label for="tagline">Frase de marca (opcional)</label><input id="tagline" name="tagline" value={business.tagline ?? ""} maxlength="80" /></div>
          <div class="field">
            <span class="field-label">Foto principal</span>
            <div class="photo-grid">
              {businessTypes.map((type) => businessPresets[type].photos.map((photo) => (
                <label class="photo-option" data-photo-type={type} hidden={type !== businessType}>
                  <input type="radio" name="heroSource" value={photo} checked={business.hero_image_url === photo} />
                  <img src={photo} alt={`Foto de biblioteca: ${businessPresets[type].label}`} width="160" height="107" loading="lazy" decoding="async" />
                </label>
              )))}
            </div>
            <label class="toggle"><input type="radio" name="heroSource" value="custom" checked={Boolean(heroCustom)} /> Usar mi propia foto (URL HTTPS)</label>
            <input id="heroImageCustom" name="heroImageCustom" type="url" value={heroCustom} maxlength="500" placeholder="https://..." aria-label="URL HTTPS de la foto propia" />
            <label class="toggle"><input type="radio" name="heroSource" value="none" checked={!business.hero_image_url} /> Sin foto (bloque de color)</label>
            <p class="muted compact-note">Fotos de Unsplash con licencia libre para uso comercial. Créditos en /stock/ATTRIBUTION.md.</p>
          </div>
          <p class="muted compact-note">Escribe los tres beneficios o deja los tres vacíos para usar los textos estándar.</p>
          <div class="field"><label for="benefit1">Beneficio 1</label><input id="benefit1" name="benefit1" value={business.benefits?.[0] ?? ""} maxlength="40" placeholder="Ofertas para clientes" /></div>
          <div class="field"><label for="benefit2">Beneficio 2</label><input id="benefit2" name="benefit2" value={business.benefits?.[1] ?? ""} maxlength="40" placeholder="Sorpresas en tu cumpleaños" /></div>
          <div class="field"><label for="benefit3">Beneficio 3</label><input id="benefit3" name="benefit3" value={business.benefits?.[2] ?? ""} maxlength="40" placeholder="Te reconocemos al volver" /></div>
          <div class="field"><label for="instagramUrl">Instagram (opcional)</label><input id="instagramUrl" name="instagramUrl" type="url" value={business.instagram_url ?? ""} maxlength="60" placeholder="https://www.instagram.com/usuario" pattern="https://www\.instagram\.com/[A-Za-z0-9._]{1,30}/?" /></div>
        </fieldset>
        <script type="application/json" id="business-presets" set:html={presetData}></script>
        <div class="field"><label for="privacyUrl">Aviso de privacidad externo (opcional)</label><input id="privacyUrl" name="privacyUrl" value={business.privacy_url ?? ""} placeholder={`/privacy/${business.slug} (automática)`} /></div>
        <div class="split"><div class="field"><label for="contactPhone">Teléfono público</label><input id="contactPhone" name="contactPhone" type="tel" inputmode="tel" autocomplete="off" value={business.contact_phone ?? ""} placeholder="(305) 555-0100" /></div><div class="field"><label for="contactEmail">Correo público</label><input id="contactEmail" name="contactEmail" type="email" value={business.contact_email ?? ""} /></div></div>
        <p class="muted compact-note">El aviso usa estos datos. Configura al menos uno antes de registrar la aprobación del dueño.</p>
        <div class="split"><div class="field"><label for="secondaryColor">Secundario</label><input id="secondaryColor" name="secondaryColor" type="color" value={business.secondary_color} /></div><div class="field"><label for="inactivityDays">Días sin visita para considerar inactivo (definido por el dueño)</label><input id="inactivityDays" name="inactivityDays" type="number" min="7" max="365" value={business.inactivity_days} /></div></div>
        <div class="split"><div class="field"><label for="timezone">Zona horaria</label><input id="timezone" name="timezone" value={business.timezone} /></div><div class="field"><label for="defaultCountry">País</label><input id="defaultCountry" name="defaultCountry" value={business.default_country} maxlength="2" /></div></div>
        <fieldset>
          <legend>Ofertas aprobadas por el dueño</legend>
          <div class="field"><label for="offerInactive">Cliente inactivo</label><input id="offerInactive" name="offerInactive" value={business.offer_inactive ?? ""} minlength="1" maxlength="200" /></div>
          <div class="field"><label for="offerBirthday">Cumpleaños</label><input id="offerBirthday" name="offerBirthday" value={business.offer_birthday ?? ""} minlength="1" maxlength="200" /></div>
          <div class="field"><label for="offerFrequent">Cliente frecuente</label><input id="offerFrequent" name="offerFrequent" value={business.offer_frequent ?? ""} minlength="1" maxlength="200" /></div>
          <div class="field"><label for="offerNew">Cliente nuevo</label><input id="offerNew" name="offerNew" value={business.offer_new ?? ""} minlength="1" maxlength="200" /></div>
        </fieldset>
        <fieldset>
          <legend>NFC de Google Review — grabar esta URL directamente en el chip</legend>
          <div class="field"><label for="googleReviewUrl">URL directa de Google Review</label><input id="googleReviewUrl" name="googleReviewUrl" type="url" value={business.google_review_url ?? ""} placeholder="https://g.page/r/.../review" /></div>
        </fieldset>
        <label class="toggle"><input name="isActive" type="checkbox" checked={business.is_active} disabled={activationLocked} /> Negocio activo</label>
        {!business.is_active && !currentSignature && <p class="muted compact-note">Un dueño activo debe firmar los Términos vigentes para habilitar la aprobación.</p>}
        {!business.is_active && currentSignature && !currentTermsApproved && <p class="muted compact-note">Registra la aprobación final del dueño para habilitar la activación.</p>}
        {business.cancelled_at && <p class="alert">El servicio fue cancelado y ya no puede activarse.</p>}
        <button class="button" type="submit">Guardar cambios</button>
      </form>
    </section>

    <div class="side-stack">
      <section class="card panel">
        <h2>NFC y enlaces</h2>
        <p class="metric-line"><strong>Visitas sin etiqueta registrada</strong><span>{untaggedVisits}</span></p>
        <div class="review-link">
          <strong>NFC de Google Review — grabar esta URL directamente en el chip</strong>
          {business.google_review_url
            ? <a href={business.google_review_url} target="_blank" rel="noreferrer">{business.google_review_url}</a>
            : <span class="muted">Pendiente de configurar.</span>}
        </div>
        <ul class="records">{tags.map((tag) => <li><div><strong>{tag.label}</strong><small>{siteUrl}/b/{business.slug}?t={tag.code}</small></div><div class="status"><span class:list={["pill", { off: !tag.is_active }]}>{tag.is_active ? "Activo" : "Pausado"}</span><form action={`/api/admin/business/${business.id}/tag-status`} method="post"><input type="hidden" name="targetId" value={tag.id} /><input type="hidden" name="active" value={tag.is_active ? "false" : "true"} /><button class="link-button" type="submit">{tag.is_active ? "Pausar" : "Activar"}</button></form></div></li>)}</ul>
        <form class="inline-form" action={`/api/admin/business/${business.id}/tag`} method="post"><div class="field"><label for="label">Nombre del nuevo NFC</label><input id="label" name="label" placeholder="Mesa 2" required /></div><button class="button secondary" type="submit">Generar</button></form>
      </section>

      <section class="card panel">
        <h2>Usuarios: {activeMemberCount} de 2</h2>
        {members.length ? <ul class="records">{members.map((member) => <li><div><strong>{member.email}</strong><small>{member.role}</small></div><div class="status"><span class:list={["pill", { off: !member.is_active }]}>{member.is_active ? "Activo" : "Pausado"}</span><form action={`/api/admin/business/${business.id}/member-status`} method="post"><input type="hidden" name="targetId" value={member.user_id} /><input type="hidden" name="active" value={member.is_active ? "false" : "true"} /><button class="link-button" type="submit">{member.is_active ? "Pausar" : "Activar"}</button></form></div></li>)}</ul> : <p class="muted">Aún no hay usuarios asignados.</p>}
        <form class="inline-form member" action={`/api/admin/business/${business.id}/invite`} method="post"><div class="field"><label for="email">Correo</label><input id="email" name="email" type="email" required /></div><div class="field"><label for="role">Rol</label><select id="role" name="role"><option value="owner">Dueño</option><option value="manager">Gerente</option><option value="viewer">Consulta</option></select></div><button class="button secondary" type="submit">Invitar</button></form>
      </section>

      <section class="card panel">
        <h2>Aprobación para activar</h2>
        {currentSignature
          ? <p class="approval-state"><strong>Firma v2 registrada</strong><span>{new Intl.DateTimeFormat("es-US", { dateStyle: "medium", timeStyle: "short" }).format(new Date(currentSignature.signed_at))}</span></p>
          : <p class="alert">Falta la firma electrónica de un dueño activo para la versión {TERMS_VERSION}.</p>}
        {business.owner_approved_at
          ? <p class="approval-state"><strong>Aprobado por {business.owner_approved_name}</strong><span>{new Intl.DateTimeFormat("es-US", { dateStyle: "medium", timeStyle: "short" }).format(new Date(business.owner_approved_at))}</span></p>
          : <p class="muted">El dueño debe aprobar la configuración final antes de activar el negocio.</p>}
        <form class="inline-form" action={`/api/admin/business/${business.id}/approve`} method="post">
          <div class="field"><label for="ownerName">Nombre del dueño que aprobó</label><input id="ownerName" name="ownerName" minlength="2" maxlength="120" required /></div>
          <button class="button secondary" type="submit" disabled={!currentSignature}>Registrar aprobación del dueño</button>
        </form>
      </section>

      <section class="card panel">
        <h2>Plazo del servicio</h2>
        {business.term_ends_at
          ? <p class="approval-state"><strong>Vence el {new Intl.DateTimeFormat("es-US", { dateStyle: "long" }).format(new Date(business.term_ends_at))}</strong><span>Smart Tap no suspende el negocio de forma automática al vencer.</span></p>
          : <p class="muted">El plazo inicial se fija al activar el negocio por primera vez.</p>}
        <form action={`/api/admin/business/${business.id}/term-extension`} method="post">
          <div class="field"><label for="termEndsAt">Nueva fecha de vencimiento</label><input id="termEndsAt" name="termEndsAt" type="date" value={currentTermDate} min={minimumExtensionDate} required /></div>
          <label class="toggle"><input name="annexSigned" type="checkbox" required /> Anexo de Extensión firmado</label>
          <button class="button secondary" type="submit">Registrar extensión</button>
        </form>
      </section>

      <section class="card panel danger-zone">
        <h2>Cancelación y copia de clientes</h2>
        <p class="muted">Descarga la copia del negocio antes de cancelar. El archivo contiene nombre, teléfono, cumpleaños, visitas y permiso de WhatsApp.</p>
        <form action={`/api/admin/business/${business.id}/export.csv`} method="post"><button class="button secondary" type="submit">Descargar CSV</button></form>
        {business.cancelled_at ? (
          <p class="approval-state"><strong>Servicio cancelado</strong><span>{new Intl.DateTimeFormat("es-US", { dateStyle: "medium", timeStyle: "short" }).format(new Date(business.cancelled_at))}</span><span>Los datos de clientes se borran al cumplir 30 días.</span></p>
        ) : (
          <form action={`/api/admin/business/${business.id}/cancel`} method="post" onsubmit="return confirm('¿Cancelar el servicio? El negocio se desactiva ahora y los datos de clientes se borran a los 30 días.')">
            <button class="button danger" type="submit">Cancelar servicio</button>
          </form>
        )}
      </section>
    </div>
  </div>
</Base>

<script>
  type Preset = { theme: string; tagline: string; benefits: string[]; inactivityDays: number; photos: string[] };
  const presets = JSON.parse(document.getElementById("business-presets")?.textContent || "{}") as Record<string, Preset>;
  const form = document.querySelector<HTMLFormElement>(".customer-screen-settings")?.closest("form");
  const typeSelect = document.querySelector<HTMLSelectElement>("#businessType");
  const themeSelect = document.querySelector<HTMLSelectElement>("#theme");
  const setValue = (id: string, value: string) => { const input = form?.querySelector<HTMLInputElement>(`#${id}`); if (input) input.value = value; };
  function showPalette(theme: string, pickFirst: boolean) {
    form?.querySelectorAll<HTMLElement>("[data-theme-palette]").forEach((group) => {
      const active = group.dataset.themePalette === theme;
      group.hidden = !active;
      group.querySelectorAll<HTMLInputElement>("input").forEach((input, index) => {
        input.disabled = !active;
        if (active && pickFirst && index === 0) input.checked = true;
      });
    });
  }
  function showPhotos(type: string) {
    form?.querySelectorAll<HTMLElement>("[data-photo-type]").forEach((option) => { option.hidden = option.dataset.photoType !== type; });
  }
  themeSelect?.addEventListener("change", () => showPalette(themeSelect.value, true));
  typeSelect?.addEventListener("change", () => {
    const preset = presets[typeSelect.value];
    if (!preset || !themeSelect) return;
    themeSelect.value = preset.theme;
    showPalette(preset.theme, true);
    showPhotos(typeSelect.value);
    setValue("tagline", preset.tagline);
    preset.benefits.forEach((benefit, index) => setValue(`benefit${index + 1}`, benefit));
    setValue("inactivityDays", String(preset.inactivityDays));
    const photo = form?.querySelector<HTMLInputElement>(`input[name="heroSource"][value="${preset.photos[0]}"]`);
    if (photo) photo.checked = true;
  });
</script>

<style>
  .back { display: inline-block; margin-bottom: 22px; color: #667085; text-decoration: none; font-weight: 650; }
  .page-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 24px; } .page-head h1 { font-size: 2.7rem; margin: 7px 0; }
  .settings-grid { display: grid; grid-template-columns: minmax(440px, 1fr) minmax(380px, .9fr); gap: 20px; margin-top: 20px; align-items: start; }
  .side-stack { display: grid; gap: 20px; } .panel { padding: 24px; } .panel h2 { font-size: 1.1rem; margin-bottom: 22px; }
  .panel > form { display: grid; gap: 16px; } .split { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; } .triple { display: grid; grid-template-columns: 1fr 1fr 1.2fr; gap: 13px; }
  fieldset { display: grid; gap: 13px; margin: 0; padding: 16px; border: 1px solid #eaecf0; border-radius: 11px; } legend { padding: 0 7px; font-weight: 750; color: #344054; }
  input[type="color"] { padding: 5px; }
  .field-label { font-size: .86rem; font-weight: 700; color: #344054; }
  .swatches { display: flex; flex-wrap: wrap; gap: 10px; } .swatches[hidden], .photo-option[hidden] { display: none; }
  .swatch { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; padding: 4px 10px 4px 6px; border: 1px solid #d0d5dd; border-radius: 999px; font-size: .85rem; cursor: pointer; }
  .swatch .chip { width: 24px; height: 24px; border-radius: 999px; border: 1px solid rgba(0,0,0,.25); }
  .swatch:has(input:checked) { border-color: #101828; box-shadow: 0 0 0 2px #101828 inset; }
  .photo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .photo-option { position: relative; display: block; border-radius: 9px; overflow: hidden; border: 2px solid transparent; cursor: pointer; }
  .photo-option img { display: block; width: 100%; height: 86px; object-fit: cover; }
  .photo-option input { position: absolute; top: 6px; left: 6px; width: 18px; height: 18px; }
  .photo-option:has(input:checked) { border-color: #101828; }
  .photo-option:has(input:focus-visible) { outline: 3px solid #155eef; outline-offset: 2px; } .toggle { display: flex; align-items: center; gap: 9px; font-weight: 650; color: #475467; }
  .compact-note { margin: -8px 0 0; } .review-link { display: grid; gap: 8px; margin: -4px 0 20px; padding: 14px; border: 1px solid #eaecf0; border-radius: 11px; overflow-wrap: anywhere; }
  .metric-line { display: flex; justify-content: space-between; gap: 16px; padding: 12px 14px; border-radius: 11px; background: #f2f4f7; }
  .metric-line span { font-size: 1.2rem; font-weight: 800; }
  .approval-state { display: grid; gap: 5px; margin: 0 0 18px; } .approval-state span { color: #667085; }
  .danger-zone { border-color: #fda29b; } .danger-zone > form { margin-bottom: 18px; }
  .button.danger { background: #b42318; }
  .records { list-style: none; padding: 0; margin: -5px 0 20px; border: 1px solid #eaecf0; border-radius: 11px; overflow: hidden; }
  .records li { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px; border-bottom: 1px solid #eaecf0; } .records li:last-child { border: 0; }
  .records li div { min-width: 0; display: grid; gap: 4px; } .records small { color: #98a2b3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .status { display: flex; align-items: center; gap: 10px; flex-shrink: 0; } .status form { margin: 0; } .status .link-button { font-size: .75rem; }
  .pill { padding: 4px 8px; border-radius: 14px; background: #ecfdf3; color: #027a48; font-size: .7rem; font-weight: 750; } .pill.off { background: #f2f4f7; color: #667085; }
  .inline-form { display: grid !important; grid-template-columns: 1fr auto; align-items: end; } .inline-form.member { grid-template-columns: 1fr 120px auto; }
  @media (max-width: 950px) { .settings-grid { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .page-head { align-items: start; flex-direction: column; } .split, .triple, .inline-form, .inline-form.member { grid-template-columns: 1fr !important; } }
</style>
