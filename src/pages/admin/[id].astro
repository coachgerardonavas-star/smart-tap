---
import Base from "../../layouts/Base.astro";
import { requirePlatformAdmin } from "../../lib/auth";
import { siteUrl as configuredSiteUrl } from "../../lib/env";
import { createSupabaseServiceClient } from "../../lib/supabase";
import type { Business } from "../../lib/types";
import { TERMS_VERSION } from "../../lib/terms";
import { customerThemePaletteNames, customerThemePalettes, customerThemes, isCustomerTheme } from "../../lib/customer-theme";
import BrandColorField from "../../components/BrandColorField.astro";
import { countryOptions, timezoneOptions } from "../../lib/regions";
import { businessPresets, businessTypes, resolveBusinessType, stockPhotoLibrary } from "../../lib/business-presets";

await requirePlatformAdmin(Astro.request, Astro.cookies);
const id = Astro.params.id ?? "";
const service = createSupabaseServiceClient();
const [businessResult, tagsResult, membersResult, signaturesResult, untaggedResult, customerCountResult, visitCountResult] = await Promise.all([
  service.from("businesses").select("*").eq("id", id).maybeSingle(),
  service.from("nfc_tags").select("*").eq("business_id", id).order("created_at"),
  service.from("business_members").select("user_id,role,is_active,created_at").eq("business_id", id).order("created_at"),
  service.from("terms_signatures").select("signed_at,user_id").eq("business_id", id).eq("terms_version", TERMS_VERSION).order("signed_at", { ascending: false }),
  service.from("visits").select("id", { count: "exact", head: true }).eq("business_id", id).eq("untagged", true),
  service.from("customers").select("id", { count: "exact", head: true }).eq("business_id", id),
  service.from("visits").select("id", { count: "exact", head: true }).eq("business_id", id),
]);
if (businessResult.error || !businessResult.data) return Astro.redirect("/admin?error=Negocio%20no%20encontrado", 302);
if (tagsResult.error || membersResult.error || signaturesResult.error || untaggedResult.error || customerCountResult.error || visitCountResult.error) throw tagsResult.error || membersResult.error || signaturesResult.error || untaggedResult.error || customerCountResult.error || visitCountResult.error;
const business = businessResult.data as Business;
const tags = tagsResult.data ?? [];
const members = await Promise.all((membersResult.data ?? []).map(async (member) => {
  const result = await service.auth.admin.getUserById(member.user_id);
  return { ...member, email: result.data.user?.email ?? "Usuario sin correo" };
}));
const activeMemberCount = members.filter((member) => member.is_active).length;
const activeOwnerIds = new Set(members.filter((member) => member.is_active && member.role === "owner").map((member) => member.user_id));
const currentSignature = signaturesResult.data?.find((signature) => activeOwnerIds.has(signature.user_id)) ?? null;
const currentTermsApproved = business.owner_approved_terms_version === TERMS_VERSION;
const activationLocked = !business.is_active && (!currentSignature || !currentTermsApproved || Boolean(business.cancelled_at));
const untaggedVisits = untaggedResult.count ?? 0;
const canDelete = (customerCountResult.count ?? 0) === 0 && (visitCountResult.count ?? 0) === 0;
const currentTermDate = business.term_ends_at?.slice(0, 10) ?? "";
const minimumExtensionDate = new Date(Math.max(Date.now(), business.term_ends_at ? new Date(business.term_ends_at).getTime() : 0) + 86_400_000).toISOString().slice(0, 10);
const siteUrl = configuredSiteUrl();
const businessType = resolveBusinessType(business.business_type);
const currentTheme = isCustomerTheme(business.theme) ? business.theme : "calido";
const themeLabels = { elegante: "Elegante", calido: "Cálido", moderno: "Moderno", colorido: "Colorido" } as const;
const currentColor = business.primary_color.toUpperCase();
const countries = countryOptions();
const timezones = timezoneOptions(business.timezone);
const roleLabels: Record<string, string> = { owner: "Dueño", manager: "Gerente", viewer: "Consulta" };
const stepsToActivate = [
  { label: "Invitar al dueño con el rol «Dueño» (panel «Personas con acceso»).", done: activeOwnerIds.size > 0 },
  { label: `El dueño entra con su propio correo en ${siteUrl}/login y firma los Términos. Tú no puedes firmar por él: es su firma electrónica.`, done: Boolean(currentSignature) },
  { label: "Completa y guarda los datos del negocio: marca, contacto, las cuatro ofertas, días de inactividad y el enlace de reseñas de Google.", done: null },
  { label: "Cuando el dueño te confirme que todo está bien, escribe su nombre abajo y registra la aprobación.", done: currentTermsApproved },
  { label: "Marca «Negocio activo» y guarda los cambios.", done: business.is_active },
];
const heroIsStock = Boolean(business.hero_image_url && stockPhotoLibrary.includes(business.hero_image_url));
const heroCustom = business.hero_image_url && !heroIsStock ? business.hero_image_url : "";
const presetData = JSON.stringify(Object.fromEntries(businessTypes.map((type) => [type, businessPresets[type]])));
const message = Astro.url.searchParams.get("message");
const formError = Astro.url.searchParams.get("error");
---

<Base title={`${business.display_name} | Smart Tap`} privateArea isAdmin>
  <a class="back" href="/admin">← Todos los negocios</a>
  <header class="page-head">
    <div><p class="eyebrow">Configuración</p><h1>{business.display_name}</h1><p class="muted">/b/{business.slug}</p></div>
    <a class="button secondary" href={`/b/${business.slug}`} target="_blank">Ver pantalla del cliente</a>
  </header>
  {message && <div class="alert success">{message}</div>}
  {formError && <div class="alert">{formError}</div>}

  <div class="settings-grid">
    <section class="card panel">
      <h2>Datos y marca</h2>
      <form action={`/api/admin/business/${business.id}/update`} method="post">
        <div class="split"><div class="field"><label for="displayName">Nombre del negocio</label><input id="displayName" name="displayName" value={business.display_name} required /><small class="hint">Como lo conocen sus clientes.</small></div><div class="field"><label for="slug">Dirección web del negocio</label><input id="slug" name="slug" value={business.slug} required autocapitalize="none" autocomplete="off" spellcheck="false" /><small class="hint">{siteUrl}/b/{business.slug}. Si ya grabaste tarjetas NFC, no la cambies: las tarjetas apuntan a esta dirección.</small></div></div>
        <div class="field"><label for="legalName">Nombre legal de la empresa (opcional)</label><input id="legalName" name="legalName" value={business.legal_name ?? ""} /><small class="hint">El nombre con el que está registrada (ej. Arepas Sabrosas LLC).</small></div>
        <div class="field"><label for="logoUrl">Enlace del logo (opcional)</label><input id="logoUrl" name="logoUrl" type="url" value={business.logo_url ?? ""} /><small class="hint">Pega la dirección web directa de la imagen (empieza con https:// y suele terminar en .png o .jpg). No se puede subir el archivo aquí. Si lo dejas vacío se usan las iniciales del negocio.</small></div>
        <fieldset class="customer-screen-settings">
          <legend>Pantalla del cliente</legend>
          <p class="muted compact-note">Esto es lo que ve el cliente del negocio cuando toca la tarjeta NFC. Míralo con el botón «Ver pantalla del cliente» de arriba.</p>
          <div class="field"><label for="businessType">Tipo de negocio</label><select id="businessType" name="businessType" required>
            {businessTypes.map((type) => <option value={type} selected={type === businessType}>{businessPresets[type].label}</option>)}
          </select></div>
          <p class="muted compact-note">Al elegir el tipo se sugieren el estilo, la frase, los beneficios, los días de inactividad, la foto y el color. Puedes cambiarlos antes de guardar.</p>
          <div class="field"><label for="theme">Estilo de la pantalla</label><select id="theme" name="theme" required>
            {customerThemes.map((value) => <option value={value} selected={value === currentTheme}>{themeLabels[value]}</option>)}
          </select><small class="hint">Cambia las letras, el fondo y el tono de la pantalla.</small></div>
          <BrandColorField value={currentColor}>
            <span class="field-label">Colores sugeridos para este estilo</span>
            {customerThemes.map((value) => (
              <div class="swatches" data-theme-palette={value} hidden={value !== currentTheme}>
                {customerThemePalettes[value].map((color) => (
                  <button type="button" class="swatch" data-color={color}><span class="chip" style={`background:${color}`}></span><span>{customerThemePaletteNames[color]}</span></button>
                ))}
              </div>
            ))}
          </BrandColorField>
          <div class="field"><label for="tagline">Frase del negocio (opcional)</label><input id="tagline" name="tagline" value={business.tagline ?? ""} maxlength="80" /><small class="hint">Una frase corta que aparece bajo el nombre. Máximo 80 letras.</small></div>
          <div class="field">
            <span class="field-label">Foto de portada</span>
            <div class="photo-grid">
              {businessTypes.map((type) => businessPresets[type].photos.map((photo) => (
                <label class="photo-option" data-photo-type={type} hidden={type !== businessType}>
                  <input type="radio" name="heroSource" value={photo} checked={business.hero_image_url === photo} />
                  <img src={photo} alt={`Foto de biblioteca: ${businessPresets[type].label}`} width="160" height="107" loading="lazy" decoding="async" />
                </label>
              )))}
            </div>
            <label class="toggle"><input type="radio" name="heroSource" value="custom" checked={Boolean(heroCustom)} /> Usar mi propia foto (enlace que empiece con https://)</label>
            <input id="heroImageCustom" name="heroImageCustom" type="url" value={heroCustom} maxlength="500" placeholder="https://..." aria-label="URL HTTPS de la foto propia" />
            <label class="toggle"><input type="radio" name="heroSource" value="none" checked={!business.hero_image_url} /> Sin foto (bloque de color)</label>
            <p class="muted compact-note">Fotos de Unsplash con licencia libre para uso comercial. Créditos en /stock/ATTRIBUTION.md.</p>
          </div>
          <p class="muted compact-note">Son tres razones para registrarse que se muestran en la pantalla. Escribe las tres o deja las tres vacías para usar los textos estándar.</p>
          <div class="field"><label for="benefit1">Beneficio 1</label><input id="benefit1" name="benefit1" value={business.benefits?.[0] ?? ""} maxlength="40" placeholder="Ofertas para clientes" /></div>
          <div class="field"><label for="benefit2">Beneficio 2</label><input id="benefit2" name="benefit2" value={business.benefits?.[1] ?? ""} maxlength="40" placeholder="Sorpresas en tu cumpleaños" /></div>
          <div class="field"><label for="benefit3">Beneficio 3</label><input id="benefit3" name="benefit3" value={business.benefits?.[2] ?? ""} maxlength="40" placeholder="Te reconocemos al volver" /></div>
          <div class="field"><label for="instagramUrl">Instagram del negocio (opcional)</label><input id="instagramUrl" name="instagramUrl" type="url" value={business.instagram_url ?? ""} maxlength="60" placeholder="https://www.instagram.com/usuario" pattern="https://www\.instagram\.com/[A-Za-z0-9._]{1,30}/?" title="Un enlace como https://www.instagram.com/usuario" /><small class="hint">Pega el enlace al perfil. En la pantalla aparece un botón «Seguir en Instagram».</small></div>
        </fieldset>
        <script type="application/json" id="business-presets" set:html={presetData}></script>
        <div class="field"><label for="privacyUrl">Aviso de privacidad propio (opcional)</label><input id="privacyUrl" name="privacyUrl" value={business.privacy_url ?? ""} placeholder={`/privacy/${business.slug} (automática)`} /><small class="hint">Déjalo vacío para usar el aviso de Smart Tap, que ya viene listo.</small></div>
        <div class="split"><div class="field"><label for="contactPhone">Teléfono del negocio</label><input id="contactPhone" name="contactPhone" type="tel" inputmode="tel" autocomplete="off" value={business.contact_phone ?? ""} placeholder="(305) 555-0100" /><small class="hint">Escríbelo normal, con código de área.</small></div><div class="field"><label for="contactEmail">Correo del negocio</label><input id="contactEmail" name="contactEmail" type="email" value={business.contact_email ?? ""} /></div></div>
        <p class="muted compact-note">Sus clientes ven estos datos en el aviso de privacidad. Pon al menos uno antes de registrar la aprobación del dueño.</p>
        <div class="field"><label for="inactivityDays">¿Cuántos días sin venir para considerarlo inactivo?</label><input id="inactivityDays" name="inactivityDays" type="number" min="7" max="365" value={business.inactivity_days} /><small class="hint">Pasado ese tiempo, el cliente aparece como «no ha vuelto» en el panel.</small></div>
        <div class="split"><div class="field"><label for="timezone">Zona horaria del negocio</label><select id="timezone" name="timezone" required>{timezones.map((option) => <option value={option.value} selected={option.value === business.timezone}>{option.label}</option>)}</select></div><div class="field"><label for="defaultCountry">País de los teléfonos de sus clientes</label><select id="defaultCountry" name="defaultCountry" required>{countries.map((option) => <option value={option.value} selected={option.value === business.default_country}>{option.label}</option>)}</select><small class="hint">Sirve para entender teléfonos escritos sin código de país.</small></div></div>
        <fieldset>
          <legend>Mensajes de oferta por situación</legend>
          <p class="muted compact-note">El dueño aprueba estos textos. Se incluyen en el WhatsApp que él mismo envía a sus clientes.</p>
          <div class="field"><label for="offerInactive">Cliente que no ha vuelto</label><input id="offerInactive" name="offerInactive" value={business.offer_inactive ?? ""} minlength="1" maxlength="200" /></div>
          <div class="field"><label for="offerBirthday">Cumpleaños</label><input id="offerBirthday" name="offerBirthday" value={business.offer_birthday ?? ""} minlength="1" maxlength="200" /></div>
          <div class="field"><label for="offerFrequent">Cliente frecuente</label><input id="offerFrequent" name="offerFrequent" value={business.offer_frequent ?? ""} minlength="1" maxlength="200" /></div>
          <div class="field"><label for="offerNew">Cliente nuevo</label><input id="offerNew" name="offerNew" value={business.offer_new ?? ""} minlength="1" maxlength="200" /></div>
        </fieldset>
        <fieldset>
          <legend>Enlace de reseñas de Google</legend>
          <div class="field"><label for="googleReviewUrl">Enlace directo para dejar una reseña</label><input id="googleReviewUrl" name="googleReviewUrl" type="url" value={business.google_review_url ?? ""} placeholder="https://g.page/r/.../review" /><small class="hint">Se graba en una tarjeta NFC aparte para pedir reseñas. También aparece como botón al terminar el registro.</small></div>
        </fieldset>
        <label class="toggle"><input name="isActive" type="checkbox" checked={business.is_active} disabled={activationLocked} /> Negocio activo</label>
        {!business.is_active && !currentSignature && <p class="muted compact-note"><strong>Por qué no se puede marcar:</strong> el dueño todavía no ha firmado los Términos. Invítalo en «Personas con acceso» y pídele que entre a {siteUrl}/login con su correo; la firma le aparece al entrar. Tú no puedes firmar por él.</p>}
        {!business.is_active && currentSignature && !currentTermsApproved && <p class="muted compact-note"><strong>Por qué no se puede marcar:</strong> falta registrar la aprobación del dueño (panel «Aprobación para activar», más abajo).</p>}
        {business.cancelled_at && <p class="alert">El servicio fue cancelado y ya no puede activarse.</p>}
        <button class="button" type="submit">Guardar cambios</button>
      </form>
    </section>

    <div class="side-stack">
      <section class="card panel">
        <h2>NFC y enlaces</h2>
        <p class="muted compact-note">Cada tarjeta NFC tiene su propio enlace: ese es el que se graba en la tarjeta.</p>
        <p class="metric-line"><strong>Visitas sin tarjeta NFC reconocida</strong><span>{untaggedVisits}</span></p>
        <div class="review-link">
          <strong>Enlace de reseñas de Google (para grabar en una tarjeta NFC)</strong>
          {business.google_review_url
            ? <span data-copy-source><a href={business.google_review_url} target="_blank" rel="noreferrer">{business.google_review_url}</a></span>
            : <span class="muted">Pendiente de configurar.</span>}
          {business.google_review_url && <button type="button" class="button secondary copy-link" data-copy>Copiar enlace</button>}
        </div>
        <ul class="records">{tags.map((tag) => <li><div><strong>{tag.label}</strong><small class="tag-link" data-copy-source>{siteUrl}/b/{business.slug}?t={tag.code}</small><button type="button" class="button secondary copy-link" data-copy>Copiar enlace</button></div><div class="status"><span class:list={["pill", { off: !tag.is_active }]}>{tag.is_active ? "Activo" : "Pausado"}</span><form action={`/api/admin/business/${business.id}/tag-status`} method="post"><input type="hidden" name="targetId" value={tag.id} /><input type="hidden" name="active" value={tag.is_active ? "false" : "true"} /><button class="link-button" type="submit">{tag.is_active ? "Pausar" : "Activar"}</button></form></div></li>)}</ul>
        <form class="inline-form" action={`/api/admin/business/${business.id}/tag`} method="post"><div class="field"><label for="label">Nombre de la nueva tarjeta NFC</label><input id="label" name="label" placeholder="Mesa 2" required /></div><button class="button secondary" type="submit">Crear tarjeta</button></form>
      </section>

      <section class="card panel">
        <h2>Personas con acceso: {activeMemberCount} de 2</h2>
        <p class="muted compact-note">Cada negocio puede tener hasta 2 personas. Dueño y Gerente pueden escribir a los clientes y eliminarlos; Consulta solo mira. Quien firma los Términos debe ser Dueño.</p>
        {members.length ? <ul class="records">{members.map((member) => <li><div><strong>{member.email}</strong><small>{roleLabels[member.role] ?? member.role}</small></div><div class="status"><span class:list={["pill", { off: !member.is_active }]}>{member.is_active ? "Activo" : "Pausado"}</span><form action={`/api/admin/business/${business.id}/member-status`} method="post"><input type="hidden" name="targetId" value={member.user_id} /><input type="hidden" name="active" value={member.is_active ? "false" : "true"} /><button class="link-button" type="submit">{member.is_active ? "Pausar" : "Activar"}</button></form></div></li>)}</ul> : <p class="muted">Aún no hay usuarios asignados.</p>}
        <form class="inline-form member" action={`/api/admin/business/${business.id}/invite`} method="post"><div class="field"><label for="email">Correo de la persona</label><input id="email" name="email" type="email" required /></div><div class="field"><label for="role">Qué puede hacer</label><select id="role" name="role"><option value="owner">Dueño (administra y firma)</option><option value="manager">Gerente (escribe a clientes)</option><option value="viewer">Consulta (solo mira)</option></select></div><button class="button secondary" type="submit">Invitar</button></form>
      </section>

      <section class="card panel">
        <h2>Aprobación para activar</h2>
        <p class="muted compact-note">Para activar un negocio nuevo se hace en este orden:</p>
        <ol class="steps">{stepsToActivate.map((step) => <li class:list={{ done: step.done }}><span aria-hidden="true">{step.done === null ? "•" : step.done ? "✓" : "○"}</span> {step.label}{step.done ? " (listo)" : ""}</li>)}</ol>
        {currentSignature
          ? <p class="approval-state"><strong>Términos firmados</strong><span>{new Intl.DateTimeFormat("es-US", { dateStyle: "medium", timeStyle: "short" }).format(new Date(currentSignature.signed_at))}</span></p>
          : <p class="alert">Falta que un dueño firme los Términos de servicio (versión {TERMS_VERSION}).</p>}
        {business.owner_approved_at
          ? <p class="approval-state"><strong>Aprobado por {business.owner_approved_name}</strong><span>{new Intl.DateTimeFormat("es-US", { dateStyle: "medium", timeStyle: "short" }).format(new Date(business.owner_approved_at))}</span></p>
          : <p class="muted">El dueño debe aprobar la configuración final antes de activar el negocio.</p>}
        <form class="inline-form" action={`/api/admin/business/${business.id}/approve`} method="post">
          <div class="field"><label for="ownerName">Nombre del dueño que te confirmó que todo está bien</label><input id="ownerName" name="ownerName" minlength="2" maxlength="120" required /></div>
          <button class="button secondary" type="submit" disabled={!currentSignature}>Registrar aprobación del dueño</button>
        </form>
      </section>

      <section class="card panel">
        <h2>Plazo del servicio</h2>
        {business.term_ends_at
          ? <p class="approval-state"><strong>Vence el {new Intl.DateTimeFormat("es-US", { dateStyle: "long" }).format(new Date(business.term_ends_at))}</strong><span>Smart Tap no suspende el negocio de forma automática al vencer.</span></p>
          : <p class="muted">El plazo inicial se fija al activar el negocio por primera vez.</p>}
        <form action={`/api/admin/business/${business.id}/term-extension`} method="post">
          <div class="field"><label for="termEndsAt">Nueva fecha de vencimiento</label><input id="termEndsAt" name="termEndsAt" type="date" value={currentTermDate} min={minimumExtensionDate} required /></div>
          <label class="toggle"><input name="annexSigned" type="checkbox" required /> Anexo de Extensión firmado</label>
          <button class="button secondary" type="submit">Registrar extensión</button>
        </form>
      </section>

      <section class="card panel danger-zone">
        <h2>Cancelación y copia de clientes</h2>
        <p class="muted">Descarga la copia del negocio antes de cancelar. El archivo contiene nombre, teléfono, cumpleaños, visitas y permiso de WhatsApp.</p>
        <form action={`/api/admin/business/${business.id}/export.csv`} method="post"><button class="button secondary" type="submit">Descargar CSV</button></form>
        {business.cancelled_at ? (
          <p class="approval-state"><strong>Servicio cancelado</strong><span>{new Intl.DateTimeFormat("es-US", { dateStyle: "medium", timeStyle: "short" }).format(new Date(business.cancelled_at))}</span><span>Los datos de clientes se borran al cumplir 30 días.</span></p>
        ) : (
          <form action={`/api/admin/business/${business.id}/cancel`} method="post" onsubmit="return confirm('¿Cancelar el servicio? El negocio se desactiva ahora y los datos de clientes se borran a los 30 días.')">
            <button class="button danger" type="submit">Cancelar servicio</button>
          </form>
        )}
        {canDelete ? (
          <form class="delete-form" action={`/api/admin/business/${business.id}/delete`} method="post" onsubmit="return confirm('¿Eliminar este negocio para siempre? No se puede deshacer.')">
            <h3>Eliminar negocio (solo pruebas o errores)</h3>
            <p class="muted">Borra el negocio, sus tarjetas NFC y sus accesos. Solo aparece si todavía no tiene clientes ni visitas. Los usuarios no se borran.</p>
            <div class="field"><label for="confirmSlug">Para confirmar, escribe su dirección web: <strong>{business.slug}</strong></label><input id="confirmSlug" name="confirmSlug" required autocomplete="off" autocapitalize="none" spellcheck="false" /></div>
            <button class="button danger" type="submit">Eliminar negocio</button>
          </form>
        ) : (
          <p class="muted">Este negocio ya tiene clientes o visitas, por eso no se puede eliminar. Usa «Cancelar servicio».</p>
        )}
      </section>
    </div>
  </div>
</Base>

<script>
  import { initBrandColorField } from "../../lib/brand-color-field";
  initBrandColorField();
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const source = button.parentElement?.querySelector<HTMLElement>("[data-copy-source]");
      const text = source?.textContent?.trim() ?? "";
      if (!text) return;
      const original = button.textContent;
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = "¡Copiado!";
      } catch {
        const range = document.createRange();
        range.selectNodeContents(source!);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        button.textContent = "Selecciónalo y copia";
      }
      setTimeout(() => { button.textContent = original; }, 2500);
    });
  });
  type Preset = { theme: string; tagline: string; benefits: string[]; inactivityDays: number; photos: string[] };
  const presets = JSON.parse(document.getElementById("business-presets")?.textContent || "{}") as Record<string, Preset>;
  const form = document.querySelector<HTMLFormElement>(".customer-screen-settings")?.closest("form");
  const typeSelect = document.querySelector<HTMLSelectElement>("#businessType");
  const themeSelect = document.querySelector<HTMLSelectElement>("#theme");
  const setValue = (id: string, value: string) => { const input = form?.querySelector<HTMLInputElement>(`#${id}`); if (input) input.value = value; };
  function showPalette(theme: string, pickFirst: boolean) {
    form?.querySelectorAll<HTMLElement>("[data-theme-palette]").forEach((group) => {
      const active = group.dataset.themePalette === theme;
      group.hidden = !active;
    });
    if (!pickFirst) return;
    // Switch to the new style's first suggested color only when the current one is
    // itself a suggestion; a color typed by hand (the brand's own) is kept.
    const current = (form?.querySelector<HTMLInputElement>("#primaryColor")?.value ?? "").trim().toUpperCase();
    const suggested = Array.from(form?.querySelectorAll<HTMLElement>("[data-color]") ?? []).map((button) => (button.dataset.color ?? "").toUpperCase());
    if (!current || suggested.includes(current)) {
      form?.querySelector<HTMLElement>(`[data-theme-palette="${theme}"] [data-color]`)?.click();
    }
  }
  function showPhotos(type: string) {
    form?.querySelectorAll<HTMLElement>("[data-photo-type]").forEach((option) => { option.hidden = option.dataset.photoType !== type; });
  }
  themeSelect?.addEventListener("change", () => showPalette(themeSelect.value, true));
  typeSelect?.addEventListener("change", () => {
    const preset = presets[typeSelect.value];
    if (!preset || !themeSelect) return;
    themeSelect.value = preset.theme;
    showPalette(preset.theme, true);
    showPhotos(typeSelect.value);
    setValue("tagline", preset.tagline);
    preset.benefits.forEach((benefit, index) => setValue(`benefit${index + 1}`, benefit));
    setValue("inactivityDays", String(preset.inactivityDays));
    const photo = form?.querySelector<HTMLInputElement>(`input[name="heroSource"][value="${preset.photos[0]}"]`);
    if (photo) photo.checked = true;
  });
</script>

