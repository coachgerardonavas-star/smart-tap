---
import Base from "../../layouts/Base.astro";
import CustomerCapture from "../../components/CustomerCapture.astro";
import { customerThemePalettes, customerThemes, isCustomerTheme } from "../../lib/customer-theme";
import { businessPresets, businessTypes, isBusinessType } from "../../lib/business-presets";

// Sales demo: fictional businesses, nothing is stored (D-048, D-057).
const requestedType = Astro.url.searchParams.get("type");
const businessType = isBusinessType(requestedType) ? requestedType : "cafe";
const preset = businessPresets[businessType];
const requestedTheme = Astro.url.searchParams.get("theme");
const theme = isCustomerTheme(requestedTheme) ? requestedTheme : preset.theme;
const requestedVisits = Number.parseInt(Astro.url.searchParams.get("visitas") ?? "", 10);
const demoVisitCount = Number.isInteger(requestedVisits) && requestedVisits >= 1 && requestedVisits <= 999 ? requestedVisits : 3;
const demoNames = {
  restaurante: "La Campiña", cafe: "Café Luna", panaderia: "Pan de Casa", barberia: "Norte",
  salon: "Studio Bella", heladeria: "Coco Loco", tienda: "Tienda Sol", gimnasio: "Fuerza Local",
} as const;
const labels = { elegante: "Elegante", calido: "Cálido", moderno: "Moderno", colorido: "Colorido" } as const;
const accent = customerThemePalettes[theme][0];
---

<Base title={`${demoNames[businessType]} | Demo ${labels[theme]}`} themeColor={accent}>
  <div class="demo-bar">
    <strong>Demostración</strong>
    <span>Los datos son ficticios y no se guardan.</span>
    <form method="get">
      <label for="type">Tipo</label><select id="type" name="type" onchange="this.form.submit()">
        {businessTypes.map((value) => <option value={value} selected={value === businessType}>{businessPresets[value].label}</option>)}
      </select>
      <label for="theme">Estilo</label><select id="theme" name="theme" onchange="this.form.submit()">
        {customerThemes.map((value) => <option value={value} selected={value === theme}>{labels[value]}</option>)}
      </select>
    </form>
    <a href="/demo">Volver</a>
  </div>
  <CustomerCapture
    demo
    demoVisitCount={demoVisitCount}
    slug="cafe-luna"
    tagCode="demo"
    businessName={demoNames[businessType]}
    businessType={businessType}
    primaryColor={accent}
    privacyUrl="/privacy"
    theme={theme}
    tagline={preset.tagline}
    benefits={[...preset.benefits]}
    heroImageUrl={preset.photos[0]}
    googleReviewUrl="https://g.page/r/example/review"
    instagramUrl="https://www.instagram.com/instagram"
  />
</Base>

<style>
  .demo-bar { min-height: 48px; display: flex; justify-content: center; align-items: center; gap: 16px; padding: 6px 18px; background: #1c1917; color: #fff; font-size: .82rem; }
  .demo-bar span { color: #d6d3d1; }
  .demo-bar form { display: flex; align-items: center; gap: 7px; margin: 0; }
  .demo-bar select { min-height: 36px; padding: 5px 30px 5px 9px; border: 1px solid #57534e; border-radius: 7px; background: #292524; color: #fff; }
  .demo-bar a { color: #fbbf24; font-weight: 750; }
  @media (max-width: 620px) { .demo-bar { min-height: 48px; justify-content: space-between; gap: 6px; padding: 6px 10px; } .demo-bar span, .demo-bar strong, .demo-bar form label { display: none; } .demo-bar form { min-width: 0; flex: 1; } .demo-bar select { min-width: 0; flex: 1; max-width: 150px; } }
</style>
