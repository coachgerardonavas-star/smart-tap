---
import Base from "../layouts/Base.astro";
import { requireAuth } from "../lib/auth";
import { createSupabaseServerClient } from "../lib/supabase";
import { safeNextPath } from "../lib/validation";

const identity = await requireAuth(Astro.request, Astro.cookies);
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const fallback = identity.isPlatformAdmin ? "/admin" : "/dashboard";
const requestedQueryNext = Astro.url.searchParams.get("next");
const queryNext = requestedQueryNext ? safeNextPath(requestedQueryNext) : fallback;
let next = queryNext.startsWith("/mfa") || queryNext.startsWith("/admin/mfa") ? fallback : queryNext;

if (identity.aal === "aal2") return Astro.redirect(next, 303);

let qrCode: string | null = null;
let errorMessage: string | null = null;
let successMessage: string | null = null;
const factorResult = await supabase.auth.mfa.listFactors();
if (factorResult.error || !factorResult.data) throw new Error("Unable to list MFA factors");
const verifiedFactor = factorResult.data.totp[0] ?? null;
let pendingFactor = factorResult.data.all.find(
  (factor) => factor.factor_type === "totp" && factor.status === "unverified",
) ?? null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const formNext = form.get("next");
  const requestedNext = formNext ? safeNextPath(formNext) : fallback;
  next = requestedNext.startsWith("/mfa") || requestedNext.startsWith("/admin/mfa") ? fallback : requestedNext;
  const action = form.get("action");
  if (action === "enroll" && !verifiedFactor) {
    if (pendingFactor) {
      const removed = await supabase.auth.mfa.unenroll({ factorId: pendingFactor.id });
      if (removed.error) errorMessage = "No pudimos reiniciar la configuración. Intenta otra vez.";
    }
    if (!errorMessage) {
      const enrolled = await supabase.auth.mfa.enroll({ factorType: "totp", friendlyName: "Smart Tap", issuer: "Smart Tap" });
      if (enrolled.error || !enrolled.data || enrolled.data.type !== "totp") {
        errorMessage = "No pudimos generar el código QR. Intenta otra vez.";
      } else {
        pendingFactor = {
          id: enrolled.data.id,
          factor_type: "totp",
          status: "unverified",
          friendly_name: enrolled.data.friendly_name,
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString(),
        };
        qrCode = enrolled.data.totp.qr_code;
        successMessage = "Escanea el código QR y escribe el código de seis dígitos.";
      }
    }
  } else if (action === "verify") {
    const code = String(form.get("code") ?? "").trim();
    const factor = verifiedFactor ?? pendingFactor;
    if (!/^\d{6}$/.test(code)) errorMessage = "Escribe el código de seis dígitos.";
    else if (!factor) errorMessage = "Genera un código QR antes de continuar.";
    else {
      const challenged = await supabase.auth.mfa.challenge({ factorId: factor.id });
      if (challenged.error || !challenged.data) errorMessage = "No pudimos iniciar la validación. Intenta otra vez.";
      else {
        const verified = await supabase.auth.mfa.verify({ factorId: factor.id, challengeId: challenged.data.id, code });
        if (verified.error) errorMessage = "El código no es válido o venció. Usa el código actual.";
        else return Astro.redirect(next, 303);
      }
    }
  }
}
const needsEnrollment = !verifiedFactor;
---

<Base title="Verificación en dos pasos | Smart Tap" privateArea>
  <div class="mfa-shell">
    <section class="card mfa-card">
      <p class="eyebrow">Cuenta Smart Tap</p>
      <h1>Confirma tu identidad</h1>
      <p class="muted">{needsEnrollment ? "Configura una app de códigos para proteger tu cuenta." : "Escribe el código actual de tu app para continuar."}</p>
      {errorMessage && <div class="alert" role="alert">{errorMessage}</div>}
      {successMessage && <div class="alert success" role="status">{successMessage}</div>}
      {qrCode && <div class="qr-panel"><img src={qrCode} alt="Código QR para configurar la verificación en dos pasos" width="240" height="240" /><ol><li>Abre tu app de códigos.</li><li>Escanea este QR.</li><li>Escribe abajo el código que muestra la app.</li></ol></div>}
      {needsEnrollment && !qrCode && <form method="post"><input type="hidden" name="action" value="enroll" /><input type="hidden" name="next" value={next} /><button class="button" type="submit">{pendingFactor ? "Generar un QR nuevo" : "Configurar MFA"}</button></form>}
      {(!needsEnrollment || qrCode || pendingFactor) && <form method="post" class="verify-form"><input type="hidden" name="action" value="verify" /><input type="hidden" name="next" value={next} /><div class="field"><label for="code">Código de seis dígitos</label><input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required autofocus /></div><button class="button" type="submit">Verificar</button></form>}
    </section>
  </div>
</Base>

<style>
  .mfa-shell { min-height: calc(100vh - 160px); display: grid; place-items: center; }
  .mfa-card { width: min(100%, 560px); padding: 34px; }
  .mfa-card h1 { margin: 9px 0 12px; font-size: clamp(2rem, 7vw, 3rem); }
  .mfa-card > .muted { line-height: 1.6; margin-bottom: 24px; }
  .mfa-card .alert { margin-bottom: 20px; }
  .qr-panel { display: grid; justify-items: center; gap: 18px; padding: 20px; margin: 20px 0; border: 1px solid #e4e7ec; border-radius: 14px; background: #fcfcfd; }
  .qr-panel img { width: min(240px, 100%); height: auto; background: #fff; border-radius: 8px; }
  .qr-panel ol { width: 100%; margin: 0; padding-left: 22px; color: #475467; line-height: 1.7; }
  form, .verify-form { display: grid; gap: 16px; }
  @media (max-width: 520px) { .mfa-card { padding: 24px; } }
</style>
