---
import PrivacyNotice from "../components/PrivacyNotice.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Privacidad | Smart Tap" description="Aviso de privacidad de Smart Tap.">
  <main class="legal card">
    <PrivacyNotice
      businessNameEs="el negocio donde te registraste"
      businessNameEn="the business where you registered"
      contactEs="sus medios de contacto habituales"
      contactEn="its usual contact channels"
    />
  </main>
</Base>

<style>
  .legal { width: min(820px, calc(100% - 28px)); margin: 28px auto; padding: clamp(22px, 6vw, 54px); }
</style>
