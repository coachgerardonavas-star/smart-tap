---
import Base from "../layouts/Base.astro";
import TurnstileWidget from "../components/TurnstileWidget.astro";
import { turnstileSiteKey } from "../lib/turnstile";
const sent = Astro.url.searchParams.has("sent");
const captchaSiteKey = turnstileSiteKey();
---
<Base title="Recupera tu cuenta | Smart Tap">
  <div class="shell"><section class="card recovery-card"><p class="eyebrow">Cuenta Smart Tap</p><h1>Recupera tu acceso</h1>
  {sent ? <div class="alert success">Si el correo tiene una cuenta, recibirás un enlace para crear otra contraseña.</div> : <><p class="muted">Te enviaremos un enlace seguro a tu correo.</p><form action="/api/auth/forgot-password" method="post"><div class="field"><label for="email">Correo</label><input id="email" name="email" type="email" autocomplete="email" required /></div>{captchaSiteKey && <TurnstileWidget siteKey={captchaSiteKey} />}<button class="button" type="submit">Enviar enlace</button></form></>}
  <a class="back" href="/login">Volver al ingreso</a></section></div>
</Base>
<style>.shell{min-height:100vh;display:grid;place-items:center;padding:28px}.recovery-card{width:min(100%,480px);padding:34px}h1{font-size:2.2rem;margin:9px 0 12px}form{display:grid;gap:18px;margin-top:25px}.back{display:inline-block;margin-top:24px;color:#667085;font-weight:650}</style>
