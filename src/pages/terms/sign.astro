---
import Base from "../../layouts/Base.astro";
import TermsNotice from "../../components/TermsNotice.astro";
import TermsSignatureCard from "../../components/TermsSignatureCard.astro";
import { requireDataAccess } from "../../lib/auth";
import { createSupabaseServiceClient } from "../../lib/supabase";
import { TERMS_VERSION } from "../../lib/terms";
import { safeNextPath } from "../../lib/validation";

const identity = await requireDataAccess(Astro.request, Astro.cookies);
if (identity.isPlatformAdmin) return Astro.redirect("/dashboard");
const service = createSupabaseServiceClient();
const { data: memberships, error: membershipError } = await service.from("business_members")
  .select("business_id")
  .eq("user_id", identity.id)
  .eq("role", "owner")
  .eq("is_active", true);
if (membershipError) throw membershipError;
const businessIds = (memberships ?? []).map((row) => row.business_id);
const { data: businesses, error: businessError } = businessIds.length
  ? await service.from("businesses").select("id,display_name,cancelled_at").in("id", businessIds).is("cancelled_at", null).order("display_name")
  : { data: [], error: null };
if (businessError) throw businessError;
const requestedBusiness = Astro.url.searchParams.get("business");
const business = (businesses ?? []).find((item) => item.id === requestedBusiness) ?? businesses?.[0] ?? null;
const next = safeNextPath(Astro.url.searchParams.get("next"));
if (!business) return Astro.redirect("/dashboard");
const { data: signature, error: signatureError } = await service.from("terms_signatures")
  .select("signed_at")
  .eq("user_id", identity.id)
  .eq("business_id", business.id)
  .eq("terms_version", TERMS_VERSION)
  .maybeSingle();
if (signatureError) throw signatureError;
if (signature) return Astro.redirect(next);
const error = Astro.url.searchParams.get("error");
---

<Base title="Firmar Términos | Smart Tap" privateArea>
  <TermsSignatureCard
    businessName={business.display_name}
    businessId={business.id}
    next={next}
    error={Boolean(error)}
    termsVersion={TERMS_VERSION}
  />
  <section class="legal card" aria-label="Términos de servicio completos">
    <TermsNotice />
  </section>
</Base>

<style>
  .legal { width: min(820px, 100%); margin: 0 auto; padding: clamp(22px, 6vw, 54px); }
</style>
