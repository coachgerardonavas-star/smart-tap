---
import PrivacyNotice from "../../components/PrivacyNotice.astro";
import Base from "../../layouts/Base.astro";
import { businessContact } from "../../lib/privacy";
import { createSupabaseServiceClient } from "../../lib/supabase";

const slug = Astro.params.slug ?? "";
const service = createSupabaseServiceClient();
const result = await service.from("businesses")
  .select("display_name,contact_phone,contact_email")
  .eq("slug", slug).eq("is_active", true).is("cancelled_at", null).maybeSingle();
const business = result.data;
const contact = businessContact(business?.contact_phone, business?.contact_email);
if (result.error || !business || !contact) Astro.response.status = 404;
---

<Base title={business && contact ? `Privacidad | ${business.display_name}` : "Aviso no disponible"} description="Aviso de privacidad de Smart Tap.">
  {business && contact ? (
    <main class="legal card">
      <PrivacyNotice businessNameEs={business.display_name} businessNameEn={business.display_name} contactEs={contact} contactEn={contact} />
    </main>
  ) : (
    <main class="not-found"><p class="eyebrow">Smart Tap</p><h1>Aviso no disponible</h1><p>Revisa el enlace con el negocio.</p></main>
  )}
</Base>

<style>
  .legal { width: min(820px, calc(100% - 28px)); margin: 28px auto; padding: clamp(22px, 6vw, 54px); }
  .not-found { min-height: 70vh; display: grid; place-content: center; text-align: center; padding: 30px; }
  .not-found h1 { margin: 8px 0; } .not-found p:last-child { color: #667085; }
</style>
