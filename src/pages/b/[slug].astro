---
import Base from "../../layouts/Base.astro";
import CustomerCapture from "../../components/CustomerCapture.astro";
import { isCustomerTheme, resolveCustomerBenefits } from "../../lib/customer-theme";
import { businessPrivacyUrl } from "../../lib/privacy";
import { createSupabaseServiceClient } from "../../lib/supabase";
import type { Business } from "../../lib/types";
import { turnstileSiteKey } from "../../lib/turnstile";

const slug = Astro.params.slug ?? "";
const tagCode = Astro.url.searchParams.get("t") ?? "";
let business: Business | null = null;

try {
  const service = createSupabaseServiceClient();
  const result = await service.from("businesses").select("*").eq("slug", slug).eq("is_active", true).is("cancelled_at", null).maybeSingle();
  business = result.data as Business | null;
} catch {
  business = null;
}

if (!business) Astro.response.status = 404;
const theme = business && isCustomerTheme(business.theme) ? business.theme : "calido";
---

<Base title={business ? `${business.display_name} | Registra tu visita` : "Enlace no disponible"} themeColor={business?.primary_color}>
  {business ? (
    <CustomerCapture
      slug={business.slug}
      tagCode={tagCode}
      businessName={business.display_name}
      primaryColor={business.primary_color}
      privacyUrl={businessPrivacyUrl(business.slug, business.privacy_url)}
      theme={theme}
      tagline={business.tagline}
      benefits={resolveCustomerBenefits(business.benefits)}
      heroImageUrl={business.hero_image_url}
      logoUrl={business.logo_url}
      googleReviewUrl={business.google_review_url}
      turnstileSiteKey={turnstileSiteKey()}
    />
  ) : (
    <section class="not-found"><h1>Este enlace no está disponible</h1><p>Confirma que usaste el NFC o enlace correcto.</p></section>
  )}
</Base>

<style>
  .not-found { min-height: 100vh; display: grid; place-content: center; padding: 30px; text-align: center; }
</style>
