---
import Base from "../../layouts/Base.astro";
import CheckInForm from "../../components/CheckInForm";
import { createSupabaseServiceClient } from "../../lib/supabase";
import type { Business } from "../../lib/types";

const slug = Astro.params.slug ?? "";
const tagCode = Astro.url.searchParams.get("t") ?? "";
let business: Business | null = null;

try {
  const service = createSupabaseServiceClient();
  const result = await service.from("businesses").select("*").eq("slug", slug).eq("is_active", true).maybeSingle();
  business = result.data as Business | null;
} catch {
  business = null;
}

if (!business) Astro.response.status = 404;
---

<Base title={business ? `${business.display_name} | Registra tu visita` : "Enlace no disponible"} themeColor={business?.primary_color}>
  {business ? (
    <div class="landing" style={`--brand: ${business.primary_color}; --brand-dark: ${business.secondary_color}`}>
      <div class="ambient one"></div><div class="ambient two"></div>
      <section class="business-intro">
        {business.logo_url ? <img src={business.logo_url} alt={`Logo de ${business.display_name}`} /> : <div class="logo-mark">{business.display_name.slice(0, 1)}</div>}
        <p class="welcome">Bienvenido a</p>
        <h1>{business.display_name}</h1>
        <p>Registra tu visita en menos de un minuto.</p>
      </section>
      <section class="form-card">
        <h2>Cuéntanos quién eres</h2>
        <p class="lead">En tus próximas visitas podremos reconocerte por tu teléfono.</p>
        <CheckInForm client:load slug={business.slug} tagCode={tagCode} businessName={business.display_name} primaryColor={business.primary_color} privacyUrl={business.privacy_url || "/privacy"} />
      </section>
      <footer>Registro seguro operado por Smart Tap</footer>
    </div>
  ) : (
    <section class="not-found">
      <h1>Este enlace no está disponible</h1>
      <p>Confirma que usaste el NFC o enlace correcto.</p>
    </section>
  )}
</Base>

<style>
  .landing { position: relative; min-height: 100vh; overflow: hidden; display: grid; place-items: center; gap: 24px; padding: 56px 22px 28px; background: linear-gradient(145deg, color-mix(in srgb, var(--brand) 7%, #fff), #fafaf9 54%, color-mix(in srgb, var(--brand-dark) 6%, #fff)); }
  .landing > *:not(.ambient) { position: relative; z-index: 1; }
  .landing { grid-template-columns: minmax(260px, 430px) minmax(340px, 470px); }
  .business-intro { padding: 30px; }
  .business-intro img, .logo-mark { width: 78px; height: 78px; border-radius: 20px; object-fit: contain; margin-bottom: 30px; }
  .logo-mark { display: grid; place-items: center; background: var(--brand); color: #fff; font-size: 2.3rem; font-weight: 900; }
  .welcome { color: var(--brand); font-weight: 800; margin-bottom: 8px; }
  .business-intro h1 { font-size: clamp(2.7rem, 7vw, 4.5rem); color: var(--brand-dark); margin-bottom: 17px; }
  .business-intro > p:last-child { color: #57534e; font-size: 1.08rem; }
  .form-card { width: 100%; padding: 32px; border: 1px solid #e7e5e4; border-radius: 22px; background: rgba(255,255,255,.94); box-shadow: 0 25px 70px rgba(28,25,23,.12); backdrop-filter: blur(12px); }
  .form-card h2 { margin-bottom: 7px; font-size: 1.55rem; }
  .lead { color: #78716c; font-size: .9rem; margin-bottom: 24px; }
  .ambient { position: absolute; width: 360px; height: 360px; border-radius: 50%; filter: blur(80px); opacity: .12; background: var(--brand); }
  .ambient.one { top: -150px; right: -80px; } .ambient.two { bottom: -180px; left: -90px; background: var(--brand-dark); }
  footer { grid-column: 1 / -1; color: #a8a29e; font-size: .75rem; }
  .not-found { min-height: 100vh; display: grid; place-content: center; text-align: center; padding: 30px; }
  @media (max-width: 780px) { .landing { grid-template-columns: 1fr; padding-top: 28px; } .business-intro { padding: 12px; text-align: center; } .business-intro img, .logo-mark { margin: 0 auto 20px; } .business-intro h1 { font-size: 2.8rem; } .form-card { padding: 25px 21px; } }
</style>
