---
import Base from "../layouts/Base.astro";
import { requireAuth } from "../lib/auth";
await requireAuth(Astro.request, Astro.cookies);
const error = Astro.url.searchParams.get("error");
---
<Base title="Crea tu contraseña | Smart Tap">
  <div class="shell">
    <section class="card password-card">
      <p class="eyebrow">Cuenta Smart Tap</p>
      <h1>Crea tu contraseña</h1>
      <p class="muted">Usa al menos 12 caracteres. Un gestor de contraseñas puede crearla y guardarla por ti.</p>
      {error && <div class="alert">{error}</div>}
      <form action="/api/auth/set-password" method="post">
        <div class="field"><label for="password">Nueva contraseña</label><input id="password" name="password" type="password" minlength="12" autocomplete="new-password" required /></div>
        <div class="field"><label for="confirmation">Confirma la contraseña</label><input id="confirmation" name="confirmation" type="password" minlength="12" autocomplete="new-password" required /></div>
        <button class="button" type="submit">Guardar y continuar</button>
      </form>
    </section>
  </div>
</Base>
<style>
  .shell { min-height: 100vh; display: grid; place-items: center; padding: 28px; } .password-card { width: min(100%, 480px); padding: 34px; }
  h1 { font-size: 2.2rem; margin: 9px 0 12px; } form { display: grid; gap: 18px; margin-top: 26px; }
</style>
