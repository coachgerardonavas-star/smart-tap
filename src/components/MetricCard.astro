---
interface Props { label: string; value: string | number; note?: string }
const { label, value, note } = Astro.props;
---
<article class="metric card">
  <span>{label}</span>
  <strong>{value}</strong>
  {note && <small>{note}</small>}
</article>

<style>
  .metric { padding: 21px; display: grid; gap: 7px; }
  span { color: #667085; font-size: .88rem; font-weight: 650; }
  strong { color: #101828; font-size: 2rem; letter-spacing: -.04em; }
  small { color: #98a2b3; }
</style>
