---
import cormorantNormal from "@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url";
import cormorantItalic from "@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-italic.woff2?url";
import jost from "@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url";
import bricolage from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import dmSans from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
import archivo from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url";
import ibmPlexSans from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";
import baloo from "@fontsource-variable/baloo-2/files/baloo-2-latin-wght-normal.woff2?url";
import nunito from "@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url";
import CheckInForm from "./CheckInForm";
import type { CustomerTheme } from "../lib/customer-theme";

type Props = {
  slug: string;
  tagCode?: string;
  businessName: string;
  primaryColor: string;
  privacyUrl: string;
  theme: CustomerTheme;
  tagline?: string | null;
  benefits: string[];
  heroImageUrl?: string | null;
  logoUrl?: string | null;
  googleReviewUrl?: string | null;
  demo?: boolean;
};

const props = Astro.props;
const fontCss: Record<CustomerTheme, string> = {
  elegante: `
    @font-face{font-family:'Cormorant Garamond Local';src:url('${cormorantNormal}') format('woff2');font-style:normal;font-weight:300 700;font-display:swap}
    @font-face{font-family:'Cormorant Garamond Local';src:url('${cormorantItalic}') format('woff2');font-style:italic;font-weight:300 700;font-display:swap}
    @font-face{font-family:'Jost Local';src:url('${jost}') format('woff2');font-style:normal;font-weight:100 900;font-display:swap}
  `,
  calido: `
    @font-face{font-family:'Bricolage Grotesque Local';src:url('${bricolage}') format('woff2');font-style:normal;font-weight:200 800;font-display:swap}
    @font-face{font-family:'DM Sans Local';src:url('${dmSans}') format('woff2');font-style:normal;font-weight:100 900;font-display:swap}
  `,
  moderno: `
    @font-face{font-family:'Archivo Local';src:url('${archivo}') format('woff2');font-style:normal;font-weight:100 900;font-display:swap}
    @font-face{font-family:'IBM Plex Sans Local';src:url('${ibmPlexSans}') format('woff2');font-style:normal;font-weight:100 700;font-display:swap}
  `,
  colorido: `
    @font-face{font-family:'Baloo 2 Local';src:url('${baloo}') format('woff2');font-style:normal;font-weight:400 800;font-display:swap}
    @font-face{font-family:'Nunito Local';src:url('${nunito}') format('woff2');font-style:normal;font-weight:200 1000;font-display:swap}
  `,
};
---

<style is:global set:html={fontCss[props.theme]}></style>
<CheckInForm client:load {...props} />
