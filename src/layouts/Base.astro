---
interface Props {
  title: string;
  description?: string;
  themeColor?: string;
  privateArea?: boolean;
  isAdmin?: boolean;
}

const {
  title,
  description = "Smart Tap convierte cada toque en una relación que el negocio puede cuidar.",
  themeColor = "#155EEF",
  privateArea = false,
  isAdmin = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <meta name="robots" content={privateArea ? "noindex,nofollow" : "index,follow"} />
    <title>{title}</title>
  </head>
  <body class:list={{ "admin-theme": isAdmin }}>
    {privateArea && (
      <header class="app-header">
        <a class="brand" href="/dashboard"><span class="brand-dot" aria-hidden="true"></span>Smart Tap</a>
        <nav aria-label="Navegación principal">
          <a href="/dashboard">Panel</a>
          {isAdmin && <a href="/admin">Negocios</a>}
          <form action="/api/auth/logout" method="post">
            <button class="link-button" type="submit">Salir</button>
          </form>
        </nav>
      </header>
    )}
    <main class:list={{ "app-main": privateArea }}>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #182230;
    background: #f7f8fa;
    font-synthesis: none;
  }

  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; min-height: 100vh; }
  button, input, select { font: inherit; }
  a { color: inherit; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { letter-spacing: -0.035em; line-height: 1.08; }
  .app-header {
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 5vw;
    background: #fff;
    border-bottom: 1px solid #e4e7ec;
  }
  .brand { font-size: 1.15rem; font-weight: 800; text-decoration: none; }
  .app-header nav { display: flex; align-items: center; gap: 22px; }
  .app-header nav a, .link-button { color: #475467; font-weight: 650; text-decoration: none; }
  .app-header form { margin: 0; }
  .link-button { border: 0; background: transparent; cursor: pointer; padding: 0; }
  .app-main { width: min(1180px, 92vw); margin: 36px auto 64px; }
  .card { background: #fff; border: 1px solid #e4e7ec; border-radius: 18px; box-shadow: 0 8px 24px rgba(16, 24, 40, .05); }
  .button {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 46px; padding: 0 18px; border: 0; border-radius: 11px;
    background: #155eef; color: #fff; font-weight: 750; text-decoration: none; cursor: pointer;
  }
  .button:hover { filter: brightness(.94); }
  .button.secondary { background: #fff; color: #344054; border: 1px solid #d0d5dd; }
  .button:disabled { opacity: .55; cursor: wait; }
  .field { display: grid; gap: 7px; }
  .field label { color: #344054; font-size: .9rem; font-weight: 700; }
  .field input, .field select {
    width: 100%; min-height: 46px; padding: 10px 13px; border: 1px solid #d0d5dd;
    border-radius: 10px; background: #fff; color: #101828; outline: none;
  }
  .field input:focus, .field select:focus { border-color: #155eef; box-shadow: 0 0 0 3px #155eef1a; }
  .muted { color: #667085; }
  .eyebrow { color: #155eef; font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .alert { padding: 12px 14px; border-radius: 10px; background: #fef3f2; color: #b42318; font-size: .92rem; }
  .success { background: #ecfdf3; color: #027a48; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 13px 14px; border-bottom: 1px solid #eaecf0; text-align: left; vertical-align: middle; }
  th { color: #667085; font-size: .76rem; letter-spacing: .04em; text-transform: uppercase; }
  td { font-size: .92rem; }

  /* Automate IT brand (Manual de Marca v3.3) for the admin area: Deep Navy header,
     Corporate Blue actions, Cyan only as a decorative line, Lime as a tiny accent. */
  .admin-theme { --ait-navy: #0A0E1A; --ait-blue: #0052CC; --ait-blue-dark: #003DA5; --ait-cyan: #00D9FF; --ait-lime: #AADD00; background: #F4F6FA; }
  .admin-theme .app-header { background: var(--ait-navy); border-bottom: 2px solid var(--ait-cyan); }
  .admin-theme .brand { display: inline-flex; align-items: center; gap: 9px; color: #fff; }
  .admin-theme .brand-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ait-lime); }
  .admin-theme .app-header nav a, .admin-theme .link-button { color: #D0D5DD; }
  .admin-theme .app-header nav a:hover, .admin-theme .link-button:hover { color: #fff; }
  .admin-theme .button { background: var(--ait-blue); }
  .admin-theme .button:hover { background: var(--ait-blue-dark); filter: none; }
  .admin-theme .button.secondary { background: #fff; color: var(--ait-blue); border-color: var(--ait-blue); }
  .admin-theme .button.danger { background: #b42318; }
  .admin-theme .eyebrow { color: var(--ait-blue); }
  .admin-theme .field input:focus, .admin-theme .field select:focus { border-color: var(--ait-blue); box-shadow: 0 0 0 3px #0052CC26; }
  .brand-dot { display: none; } .admin-theme .brand-dot { display: inline-block; }
  @media (max-width: 700px) {
    .app-header { padding: 0 20px; }
    .app-header nav { gap: 13px; font-size: .9rem; }
    .app-main { width: min(100% - 28px, 1180px); margin-top: 24px; }
    .table-scroll { overflow-x: auto; }
  }
</style>
